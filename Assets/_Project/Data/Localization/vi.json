            "key": "ui.card.log_caption",
            "text": "Từ ký ức của {0}"
        },
        {
            "key": "friend.tilly.name",
            "text": "Tilly"
        },
        {
            "key": "friend.tilly.repair_log",
            "text": "Sáng nay lại đi dọc vành núi lúc bình minh, Tilly ríu rít bên vai. Mặt Trăng vẫn còn đây, Trái Đất vẫn treo trên trời, cà phê vẫn dở tệ: mọi chuyện vẫn ổn. — Ines"
        },
        {
            "key": "friend.bell.name",
            "text": "Bell"
        },
        {
            "key": "friend.bell.repair_log",
            "text": "Mình lắp Bell từ một máy thu hỏng và bốn cái chân máy quay, để đài vẫn phát khi mình ngủ. Cô ấy biết nhảy. Phần đó mình không hề lắp. — Ro"
        },
        {
            "key": "log.ro_1",
            "text": "Đêm đầu tiên của Lumen After Dark. Ba thính giả và một chiếc rover cứ lăn lại gần mỗi khi mình mở bài chậm. Khán giả tuyệt nhất mình từng có. — Ro"
        },
        {
            "key": "cassette.after_dark_1.title",
            "text": "Lumen After Dark, Tập 1"
        },
        {
            "key": "cassette.after_dark_1.note",
            "text": "Buổi phát sóng đêm đầu tiên. Khán giả: ba người, một chiếc rover, một chậu húng quế. Chậu húng quế còn xin bài."
        },
        {
            "key": "cassette.dust_and_honey.title",
            "text": "Bụi & Mật ong"
        },
        {
            "key": "cassette.dust_and_honey.note",
            "text": "Thu với cái micro dán băng keo lên cửa khoang. Nghe tiếng thịch thì đó là Kenji."
        },
        {
            "key": "cassette.slow_orbit.title",
            "text": "Quỹ đạo chậm"
        },
        {
            "key": "cassette.slow_orbit.note",
            "text": "Cho những đêm Trái Đất trông gần như đi bộ tới được. Không đâu. Mình thử rồi."
        },
        {
            "key": "ticker.bell.home",
            "text": "Bell về nhà trước bạn. Cô ấy bảo đèn hiên vẫn sáng."
        },
        {
