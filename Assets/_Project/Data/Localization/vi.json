        {
            "key": "db.unit07.name",
            "text": "07"
        },
        {
            "key": "db.unit07.readout",
            "text": "SSR-5 · S/N 3-0417 · TÀI SẢN LUMEN SỐ 07"
        },
        {
            "key": "db.elder06.name",
            "text": "06"
        },
        {
            "key": "db.elder06.readout",
            "text": "SSR-3 · ĐƠN VỊ 06 · GIỮ TRẠM TIẾP SÓNG · NHIỆM VỤ: GIỮ LIÊN LẠC RELAY.2 · DỪNG: PIN 0%"
        },
        {
            "key": "db.elder06.history",
            "text": "Đơn vị thứ sáu của trạm, một xe SSR-3 giữ trạm tiếp sóng. Một việc, không có ổ lắp: giữ liên lạc cho trạm, ngoài ra không làm gì. — K."
        },
        {
            "key": "db.elder01.name",
            "text": "01"
        },
        {
            "key": "db.elder01.readout",
            "text": "SSR-3 · ĐƠN VỊ 01 · XE KHẢO SÁT · NHIỆM VỤ: KHẢO SÁT ĐƯỜNG LÊN ĐỈNH · DỪNG: ĐÁ LỞ"
        },
        {
            "key": "db.elder01.history",
            "text": "Đơn vị 01 lên đây cùng mấy thùng mô-đun nhà ở đầu tiên năm 84. Lúc ấy nó đã sáu tuổi, vậy mà vẫn leo dốc vững nhất trạm. — K."
        },
        {
            "key": "db.cargo_lander.name",
            "text": "Tàu đổ bộ"
        },
        {
            "key": "db.cargo_lander.readout",
            "text": "TÀU ĐỔ BỘ CHỞ HÀNG · VIS CL-4 · HẠ CÁNH 1987"
        },
        {
            "key": "db.cargo_lander.history",
            "text": "Xuống trong đợt thả hàng năm 87. Chiếc chị em của nó đáp xuống hẻm, mạnh tay hơn. Tháng Mười năm 88, 07 dỡ mấy thùng cuối cùng khỏi chiếc này. — K."
        },
        {
            "key": "db.kestrel3.name",
            "text": "Kestrel-3"
        },
        {
            "key": "db.kestrel3.readout",
            "text": "KESTREL-3 · VỆ TINH TIẾP SÓNG · RƠI 10/1988"
        },
        {
            "key": "db.kestrel3.history",
            "text": "Vệ tinh tiếp sóng của Meridian. Mất định hướng rồi rơi xuống lòng chảo của tụi mình, vẫn chĩa về phía các tàu Ark. Giờ Meridian phải nói chuyện qua chảo ăng-ten lớn của tụi mình. — Ro"
        },
        {
            "key": "db.habitat.name",
            "text": "Nhà ở & phòng thí nghiệm"
        },
        {
            "key": "db.habitat.readout",
            "text": "SEC-04 · NHÀ Ở & PHÒNG THÍ NGHIỆM · CỬA KÍN ĐÃ KHÓA · CHƯA CÓ ĐIỆN"
        },
        {
            "key": "db.habitat.history",
            "text": "Ba mô-đun VIS, đội xây dựng dựng lên năm 84, một năm trước khi tụi mình dọn tới: chỗ ở, phòng thí nghiệm và kho. — K."
        },
        {
            "key": "db.solar_array.name",
            "text": "Giàn pin mặt trời đổ"
        },
        {
            "key": "db.solar_array.readout",
            "text": "GIÀN PIN MẶT TRỜI CHÍNH · ĐỔ · KHÔNG CÓ ĐIỆN RA"
        },
        {
            "key": "db.solar_array.history",
            "text": "Giàn pin chính của Lumen. Ở vùng cực, Mặt Trời chẳng bao giờ lên cao, nên giàn xoay suốt ngày, đuổi theo nó quanh đường chân trời. — K."
        },
        {
            "key": "db.radio_tower.name",
            "text": "Tháp radio"
        },
        {
            "key": "db.radio_tower.readout",
            "text": "THÁP RADIO · LIÊN KẾT LÊN ĐỈNH · ĐANG TẮT"
        },
        {
            "key": "db.radio_tower.history",
            "text": "Mọi thứ tụi mình gửi đi đều qua tháp này trước, rồi mới lên chảo ăng-ten lớn trên Đỉnh núi. Chủ nhật thì nó phát chương trình của mình. — Ro"
        },
        {
            "key": "db.seismic_station.name",
            "text": "Trạm địa chấn"
        },
        {
            "key": "db.seismic_station.readout",
            "text": "TRẠM ĐỊA CHẤN · ĐẶT 1971 · NỐI ĐIỆN LUMEN 1984 · BẢN GHI CUỐI 28/10/1988 · PIN 0%"
        },
        {
            "key": "db.seismic_station.history",
            "text": "Tổ bay năm 71 để lại. Nó đã ghi được mười ba năm nền đất yên ổn, nên ILC đặt Lumen ở đây. Chúng tôi nối nó vào lưới điện của trạm. — Ines"
        },
        {
            "key": "db.retroreflector.name",
            "text": "Gương phản xạ laser"
        },
        {
            "key": "db.retroreflector.readout",
            "text": "GƯƠNG PHẢN XẠ · 100 LĂNG KÍNH · ĐẶT 1971 · CHỈNH HƯỚNG 1984"
        },
        {
            "key": "db.retroreflector.history",
