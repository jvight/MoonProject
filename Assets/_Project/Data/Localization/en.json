        {
            "key": "upgrade.radio_tower.name",
            "text": "Radio Tower"
        },
        {
            "key": "upgrade.radio_tower.1.title",
            "text": "Wake the old mast"
        },
        {
            "key": "upgrade.radio_tower.1.effect",
            "text": "Power the tired antenna: its beacon glows again and the music reaches farther."
        },
        {
            "key": "upgrade.radio_tower.2.title",
            "text": "Raise the mast"
        },
        {
            "key": "upgrade.radio_tower.2.effect",
            "text": "A taller mast and a warmer lamp: the radio stays clear deep into the dunes."
        },
        {
            "key": "upgrade.radio_tower.3.title",
            "text": "Light the whole basin"
        },
        {
            "key": "upgrade.radio_tower.3.effect",
            "text": "The tower sings across the crater; home glows like a lantern on a winter night."
        },
        {
            "key": "upgrade.rover.hover_jump.name",
            "text": "Hover-Jump"
        },
        {
            "key": "upgrade.rover.hover_jump.1.title",
            "text": "Kenji's spring coils"
        },
        {
            "key": "upgrade.rover.hover_jump.1.effect",
            "text": "Coil up and let go: 07 leaps over gaps and floats across the dunes."
        },
        {
            "key": "relic.cassette_player.name",
            "text": "Ro's Mixtape"
        },
        {
            "key": "relic.cassette_player.memory",
            "text": "A walkman with a tape still inside, labelled in Ro's handwriting: \"for the long drive\". Side B just says \"for when we come home\"."
        },
        {
            "key": "relic.rubber_duck.name",
            "text": "Senior Debugging Consultant"
        },
        {
            "key": "relic.rubber_duck.memory",
            "text": "Kenji explained every broken part to this duck before fixing it. The duck never said a word, and it was usually right."
        },
        {
            "key": "relic.golden_record.name",
            "text": "The Lumen Record"
        },
        {
            "key": "relic.golden_record.memory",
            "text": "Ro's homemade golden record: greetings from four people, one rover and a very proud basil plant, ready for anyone listening."
        },
        {
            "key": "relic.astronaut_boot.name",
            "text": "Ines's Field Boot"
        },
        {
            "key": "relic.astronaut_boot.memory",
            "text": "Ines walked the rim every morning \"to check the Moon was still there\". The tread is still packed with dust from her favourite ridge."
        },
        {
            "key": "relic.teapot.name",
            "text": "The First Real Tea"
        },
        {
            "key": "relic.teapot.memory",
            "text": "Theo brewed mint grown in lunar soil in this dented pot. \"The first tea on the Moon that tasted like anything,\" Ro wrote on the lid."
        },
        {
            "key": "relic.garden_gnome.name",
            "text": "Chief Security Officer"
        },
        {
            "key": "relic.garden_gnome.memory",
            "text": "Theo smuggled him aboard as a joke and put him in charge of the seedlings. Nothing was ever stolen on his watch."
        },
