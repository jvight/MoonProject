<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="GameUI.uss" />
    <ui:VisualElement name="moon-root" class="moon-root" picking-mode="Ignore">
        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:VisualElement name="prompt-anchor" class="world-anchor" picking-mode="Ignore">
                <ui:VisualElement name="prompt-center" class="world-anchor__center" picking-mode="Ignore">
                    <ui:VisualElement name="prompt" class="prompt" picking-mode="Ignore">
                        <ui:VisualElement name="prompt-shadow" class="soft-shadow soft-shadow--chip" />
                        <ui:VisualElement name="prompt-body" class="chip">
                            <ui:VisualElement name="prompt-glyph" class="glyph">
                                <ui:Label name="prompt-glyph-label" class="glyph__label" />
                            </ui:VisualElement>
                            <ui:Label name="prompt-word" class="chip__word" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="salvage-ring-anchor" class="world-anchor" picking-mode="Ignore">
                <ui:VisualElement name="salvage-ring-middle" class="world-anchor__middle" picking-mode="Ignore">
                    <ui:VisualElement name="salvage-ring" class="salvage-ring" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="build-reason-anchor" class="world-anchor" picking-mode="Ignore">
                <ui:VisualElement name="build-reason-center" class="world-anchor__center" picking-mode="Ignore">
                    <ui:VisualElement name="build-reason" class="build-reason" picking-mode="Ignore">
                        <ui:VisualElement name="build-reason-shadow" class="soft-shadow soft-shadow--chip" />
                        <ui:VisualElement name="build-reason-body" class="chip build-reason__body" picking-mode="Ignore">
                            <ui:Label name="build-reason-text" class="chip__word build-reason__text" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="hud-frame" class="safe-frame" picking-mode="Ignore">
                <ui:VisualElement class="unlock-anchor" picking-mode="Ignore">
                    <ui:VisualElement name="unlock-card" class="unlock-card" picking-mode="Ignore">
                        <ui:VisualElement name="unlock-glyph" class="glyph" picking-mode="Ignore">
                            <ui:Label name="unlock-glyph-label" class="glyph__label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="unlock-card__text" picking-mode="Ignore">
                            <ui:Label name="unlock-card-verb" class="unlock-card__verb" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="battery-dial" class="battery-dial" picking-mode="Ignore">
                    <ui:VisualElement name="battery-dial-face" class="battery-dial__face" picking-mode="Ignore">
                        <ui:VisualElement name="battery-dial-ring" class="battery-dial__ring" picking-mode="Ignore" />
                        <ui:Label name="battery-dial-value" class="battery-dial__value" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="next-line" picking-mode="Ignore">
                    <ui:VisualElement name="next-line" class="name-tag" picking-mode="Ignore">
                        <ui:VisualElement name="next-line-shadow" class="soft-shadow soft-shadow--name" />
                        <ui:Label name="next-line-text" class="next-line__text" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="protocol" class="recovery-board protocol-readout" picking-mode="Ignore">
                    <ui:Label name="protocol-title" class="recovery-board__title protocol-readout__title" picking-mode="Ignore" />
                    <ui:VisualElement name="protocol-rows" class="recovery-board__rows" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="recipe-card" class="recipe-card" picking-mode="Ignore">
                    <ui:VisualElement name="recipe-card-shadow" class="soft-shadow soft-shadow--name" />
                    <ui:Label name="recipe-card-title" class="recipe-card__title" picking-mode="Ignore" />
                    <ui:Label name="recipe-card-level" class="recipe-card__level" picking-mode="Ignore" />
                    <ui:VisualElement class="recipe-card__row" picking-mode="Ignore">
                        <ui:Label name="recipe-card-needs-word" class="recipe-card__word" picking-mode="Ignore" />
                        <ui:VisualElement name="recipe-card-needs" class="recipe" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="recipe-card-where" class="recipe-card__where" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="pickup-feed" class="pickup-feed" picking-mode="Ignore" />
                <ui:VisualElement name="look-hint" class="look-hint" picking-mode="Ignore">
                    <ui:VisualElement class="look-hint__body" picking-mode="Ignore">
                        <ui:VisualElement name="look-hint-shadow" class="soft-shadow soft-shadow--chip" />
                        <ui:VisualElement name="look-hint-chip" class="chip">
                            <ui:VisualElement name="look-hint-glyph" class="glyph">
                                <ui:Label name="look-hint-glyph-label" class="glyph__label" />
                            </ui:VisualElement>
                            <ui:Label name="look-hint-word" class="chip__word" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="build-strip" class="build-strip" picking-mode="Ignore">
                    <ui:VisualElement name="build-strip-shadow" class="soft-shadow soft-shadow--panel" />
                    <ui:VisualElement name="build-strip-body" class="panel build-strip__body" picking-mode="Ignore">
                        <ui:VisualElement class="build-strip__header" picking-mode="Ignore">
                            <ui:Label name="build-strip-title" class="caption build-strip__title" picking-mode="Ignore" />
                            <ui:Label name="build-strip-status" class="caption caption--quiet build-strip__status" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="build-strip-cards" class="build-strip__cards" picking-mode="Ignore" />
                        <ui:VisualElement class="build-strip__detail" picking-mode="Ignore">
                            <ui:VisualElement class="build-strip__info" picking-mode="Ignore">
                                <ui:Label name="build-strip-name" class="build-strip__name" picking-mode="Ignore" />
                                <ui:Label name="build-strip-desc" class="build-strip__desc" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="build-strip-recipe" class="recipe build-strip__recipe" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="build-strip-footer" class="build-strip__footer" picking-mode="Ignore">
                            <ui:VisualElement class="build-strip__hint-item" picking-mode="Ignore">
                                <ui:VisualElement name="build-strip-glyph-primary" class="glyph glyph--small" picking-mode="Ignore">
                                    <ui:Label name="build-strip-glyph-primary-label" class="glyph__label" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label name="build-strip-hint-primary" class="build-strip__hint" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="build-strip__hint-item" picking-mode="Ignore">
                                <ui:VisualElement name="build-strip-glyph-secondary" class="glyph glyph--small" picking-mode="Ignore">
                                    <ui:Label name="build-strip-glyph-secondary-label" class="glyph__label" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label name="build-strip-hint-secondary" class="build-strip__hint" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="cargo" class="cargo" picking-mode="Ignore">
            <ui:VisualElement name="cargo-panel" class="cargo__panel" picking-mode="Ignore">
                <ui:VisualElement name="cargo-canvas" class="cargo__canvas" picking-mode="Ignore" />
                <ui:Label name="cargo-hold-title" class="cargo__heading loc" text="ui.cargo.hold" picking-mode="Ignore" />
                <ui:Label name="cargo-right-title" class="cargo__heading loc" text="ui.cargo.tab_seven" picking-mode="Ignore" />
                <ui:Label name="cargo-boot" class="cargo__boot" picking-mode="Ignore" />
                <ui:VisualElement name="cargo-hold-grid" class="cargo__grid" picking-mode="Ignore" />
                <ui:VisualElement name="cargo-sockets" class="cargo__sockets" picking-mode="Ignore" />
                <ui:VisualElement name="cargo-home-grid" class="cargo__grid cargo__grid--home" picking-mode="Ignore" />
                <ui:VisualElement name="cargo-tooltip" class="cargo__tooltip" picking-mode="Ignore">
                    <ui:Label name="cargo-tooltip-name" class="cargo__tooltip-name" picking-mode="Ignore" />
                    <ui:Label name="cargo-tooltip-desc" class="cargo__tooltip-desc" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="cargo-toast" class="cargo__toast" picking-mode="Ignore">
                    <ui:Label name="cargo-toast-text" class="cargo__toast-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause" class="pause" picking-mode="Ignore">
            <ui:VisualElement name="pause-veil" class="pause__veil" />
            <ui:VisualElement name="title-crt" class="title-crt" picking-mode="Ignore" />
            <ui:VisualElement name="menu-frame" class="safe-frame" picking-mode="Ignore">
                <ui:VisualElement name="title-screen" class="title-screen" picking-mode="Ignore">
                    <ui:VisualElement name="title-wordmark" class="title-screen__wordmark" picking-mode="Ignore" />
                    <ui:VisualElement name="title-subtitle-row" class="title-screen__subtitle-row" picking-mode="Ignore">
                        <ui:Label name="title-subtitle-prefix" class="title-screen__subtitle-prefix" picking-mode="Ignore" />
                        <ui:Label name="title-subtitle" class="title-screen__subtitle loc" text="ui.title.subtitle" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="title-rule" class="title-screen__rule" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-frame" class="pause__frame" picking-mode="Ignore">
                    <ui:VisualElement name="pause-stack" class="pause__stack" picking-mode="Ignore">
                        <ui:VisualElement name="pause-main" class="pause__main" picking-mode="Ignore">
                            <ui:VisualElement name="pause-main-shadow" class="soft-shadow soft-shadow--panel" />
                            <ui:VisualElement name="pause-main-body" class="panel pause__panel">
                                <ui:VisualElement class="pause__header">
                                    <ui:VisualElement class="pause__titles">
                                        <ui:Label class="pause__heading loc" text="ui.pause.heading" />
                                        <ui:Label class="pause__subheading loc" text="ui.pause.subheading" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="pause__pages">
                                    <ui:VisualElement name="page-main" class="pause__page">
                                        <ui:Button name="button-resume" class="menu-button" />
                                        <ui:Button name="button-new-game" class="menu-button loc"
                                                   text="ui.title.new_game" />
                                        <ui:Button name="button-settings" class="menu-button loc"
                                                   text="ui.pause.settings" />
                                        <ui:Button name="button-credits" class="menu-button loc"
                                                   text="ui.title.credits" />
                                        <ui:Button name="button-quit-to-title" class="menu-button loc"
                                                   text="ui.pause.quit_to_title" />
                                        <ui:Button name="button-quit" class="menu-button loc" text="ui.pause.quit" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="page-new-game" class="pause__page">
                                        <ui:Label class="pause__question loc" text="ui.title.new_game_question" />
                                        <ui:Label class="pause__aside loc" text="ui.title.new_game_aside" />
                                        <ui:Button name="button-new-game-keep" class="menu-button loc"
                                                   text="ui.title.new_game_keep" />
                                        <ui:Button name="button-new-game-confirm" class="menu-button menu-button--quiet loc"
                                                   text="ui.title.new_game_confirm" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="page-language" class="pause__page" />
                                    <ui:VisualElement name="page-quit" class="pause__page">
                                        <ui:Label class="pause__question loc" text="ui.pause.quit_question" />
                                        <ui:Label class="pause__aside loc" text="ui.pause.quit_aside" />
                                        <ui:Button name="button-quit-stay" class="menu-button loc"
                                                   text="ui.pause.quit_stay" />
                                        <ui:Button name="button-quit-confirm" class="menu-button menu-button--quiet loc"
                                                   text="ui.pause.quit_confirm" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="pause-settings" class="pause__settings" picking-mode="Ignore">
                            <ui:VisualElement name="pause-settings-shadow" class="soft-shadow soft-shadow--panel" />
                            <ui:VisualElement name="pause-settings-body" class="panel pause__panel pause__panel--settings">
                                <ui:VisualElement name="settings-tabs" class="settings-tabs" picking-mode="Ignore">
                                    <ui:VisualElement class="settings-tab-wrap settings-tab-wrap--on" picking-mode="Ignore">
                                        <ui:Button name="button-tab-sound" class="settings-tab settings-tab--on loc" text="ui.settings.sound" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="settings-tab-wrap" picking-mode="Ignore">
                                        <ui:Button name="button-tab-camera" class="settings-tab loc" text="ui.settings.tab_camera" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="settings-tab-wrap" picking-mode="Ignore">
                                        <ui:Button name="button-tab-display" class="settings-tab loc" text="ui.settings.tab_display" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="settings-page-sound" class="settings-page">
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.master" />
                                    <ui:SliderInt name="slider-master" class="setting-row__slider" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.music" />
                                    <ui:SliderInt name="slider-music" class="setting-row__slider" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.sfx" />
                                    <ui:SliderInt name="slider-sfx" class="setting-row__slider" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.ambience" />
                                    <ui:SliderInt name="slider-ambience" class="setting-row__slider" />
                                </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="settings-page-camera" class="settings-page">
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.look_speed" />
                                    <ui:SliderInt name="slider-look" class="setting-row__slider" />
                                    <ui:Label name="look-value" class="setting-row__value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.invert_look" />
                                    <ui:Toggle name="toggle-invert" class="setting-row__toggle" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.rumble" />
                                    <ui:Toggle name="toggle-rumble" class="setting-row__toggle" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.rumble_strength" />
                                    <ui:SliderInt name="slider-rumble" class="setting-row__slider" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.gentle_camera" />
                                    <ui:Toggle name="toggle-gentle-camera" class="setting-row__toggle" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.guidance" />
                                    <ui:Toggle name="toggle-guidance" class="setting-row__toggle" />
                                </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="settings-page-display" class="settings-page">
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.display.resolution" />
                                    <ui:Button name="button-resolution-prev" class="menu-button menu-button--compact cycle__arrow loc" text="ui.display.prev" />
                                    <ui:Label name="resolution-value" class="cycle__value" />
                                    <ui:Button name="button-resolution-next" class="menu-button menu-button--compact cycle__arrow loc" text="ui.display.next" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.display.mode" />
                                    <ui:Button name="button-mode-prev" class="menu-button menu-button--compact cycle__arrow loc" text="ui.display.prev" />
                                    <ui:Label name="mode-value" class="cycle__value" />
                                    <ui:Button name="button-mode-next" class="menu-button menu-button--compact cycle__arrow loc" text="ui.display.next" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.display.vsync" />
                                    <ui:Toggle name="toggle-vsync" class="setting-row__toggle" />
                                </ui:VisualElement>
                                <ui:VisualElement name="row-fps" class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.display.fps_cap" />
                                    <ui:Button name="button-fps-prev" class="menu-button menu-button--compact cycle__arrow loc" text="ui.display.prev" />
                                    <ui:Label name="fps-value" class="cycle__value" />
                                    <ui:Button name="button-fps-next" class="menu-button menu-button--compact cycle__arrow loc" text="ui.display.next" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.text_size" />
                                    <ui:Button name="button-text-size" class="menu-button menu-button--compact" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.language" />
                                    <ui:Button name="button-language" class="menu-button menu-button--compact" />
                                </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Button name="button-settings-back" class="menu-button menu-button--quiet loc"
                                           text="ui.settings.back" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="title-key-hint" class="title-key-hint loc" text="ui.title.key_hint" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="credits" class="credits" picking-mode="Ignore">
                <ui:VisualElement name="credits-panel" class="panel credits__panel" picking-mode="Ignore">
                    <ui:Label name="credits-title" class="credits__title" picking-mode="Ignore" />
                    <ui:ScrollView name="credits-scroll" class="credits__scroll" mode="Vertical"
                                   vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
                    <ui:Button name="button-credits-back" class="menu-button menu-button--quiet loc"
                               text="ui.settings.back" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="title-crt-overlay" class="title-crt-overlay" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="save-tick" class="save-tick" picking-mode="Ignore">
            <ui:Label class="save-tick__word loc" text="ui.save_tick.word" picking-mode="Ignore" />
            <ui:VisualElement name="save-tick-check" class="save-tick__check" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="curtain" class="curtain" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
