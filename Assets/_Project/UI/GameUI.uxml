<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="GameUI.uss" />
    <ui:VisualElement name="moon-root" class="moon-root" picking-mode="Ignore">
        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:VisualElement name="reticle" class="reticle" picking-mode="Ignore">
                <ui:VisualElement name="reticle-rest" class="reticle__ring reticle__ring--rest" />
                <ui:VisualElement name="reticle-hover" class="reticle__ring reticle__ring--hover" />
            </ui:VisualElement>
            <ui:VisualElement name="friend-anchor" class="world-anchor" picking-mode="Ignore">
                <ui:VisualElement name="friend-center" class="world-anchor__center" picking-mode="Ignore">
                    <ui:VisualElement name="friend-readout" class="friend-readout" picking-mode="Ignore">
                        <ui:VisualElement name="friend-readout-shadow" class="soft-shadow soft-shadow--chip" />
                        <ui:VisualElement class="chip friend-chip">
                            <ui:Label name="friend-parts-label" class="friend-chip__label" picking-mode="Ignore" />
                            <ui:VisualElement name="friend-pips" class="friend-pips" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="friend-name-anchor" class="world-anchor" picking-mode="Ignore">
                <ui:VisualElement name="friend-name-center" class="world-anchor__center" picking-mode="Ignore">
                    <ui:VisualElement name="friend-name" class="name-tag" picking-mode="Ignore">
                        <ui:VisualElement name="friend-name-shadow" class="soft-shadow soft-shadow--name" />
                        <ui:Label name="friend-name-text" class="name-tag__name" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="prompt-anchor" class="world-anchor" picking-mode="Ignore">
                <ui:VisualElement name="prompt-center" class="world-anchor__center" picking-mode="Ignore">
                    <ui:VisualElement name="prompt" class="prompt" picking-mode="Ignore">
                        <ui:VisualElement name="prompt-shadow" class="soft-shadow soft-shadow--chip" />
                        <ui:VisualElement name="prompt-body" class="chip">
                            <ui:VisualElement name="prompt-glyph" class="glyph">
                                <ui:Label name="prompt-glyph-label" class="glyph__label" />
                            </ui:VisualElement>
                            <ui:Label name="prompt-word" class="chip__word" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="relay-tag-anchor" class="world-anchor" picking-mode="Ignore">
                <ui:VisualElement name="relay-tag-center" class="world-anchor__center" picking-mode="Ignore">
                    <ui:VisualElement name="relay-tag" class="relay-tag" picking-mode="Ignore">
                        <ui:VisualElement name="relay-tag-shadow" class="soft-shadow soft-shadow--chip" />
                        <ui:VisualElement name="relay-tag-body" class="chip relay-tag__body">
                            <ui:VisualElement class="relay-tag__row">
                                <ui:VisualElement name="relay-tag-ring" class="relay-tag__ring">
                                    <ui:VisualElement name="relay-tag-icon" class="relay-icon relay-icon--tag" />
                                </ui:VisualElement>
                                <ui:VisualElement name="relay-tag-recipe" class="recipe relay-tag__recipe" />
                            </ui:VisualElement>
                            <ui:Label name="relay-tag-need" class="recipe__need relay-tag__need" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="salvage-ring-anchor" class="world-anchor" picking-mode="Ignore">
                <ui:VisualElement name="salvage-ring-middle" class="world-anchor__middle" picking-mode="Ignore">
                    <ui:VisualElement name="salvage-ring" class="salvage-ring" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="site-name-anchor" class="world-anchor" picking-mode="Ignore">
                <ui:VisualElement name="site-name-center" class="world-anchor__center" picking-mode="Ignore">
                    <ui:VisualElement name="site-name" class="name-tag" picking-mode="Ignore">
                        <ui:VisualElement name="site-name-shadow" class="soft-shadow soft-shadow--name" />
                        <ui:Label name="site-name-text" class="name-tag__name site-name" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="hud-frame" class="safe-frame" picking-mode="Ignore">
                <ui:VisualElement name="home-meter" class="home-meter" picking-mode="Ignore">
                    <ui:VisualElement name="home-meter-arc" class="home-meter__arc" picking-mode="Ignore" />
                    <ui:VisualElement class="home-meter__row" picking-mode="Ignore">
                        <ui:Label name="home-meter-value" class="home-meter__value" picking-mode="Ignore" />
                        <ui:Label class="home-meter__unit loc" text="ui.meter.unit" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="home-meter-key" class="home-meter__key" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="kit-title" class="kit-title" picking-mode="Ignore">
                    <ui:VisualElement class="name-tag" picking-mode="Ignore">
                        <ui:VisualElement name="kit-title-shadow" class="soft-shadow soft-shadow--name" />
                        <ui:Label name="kit-title-name" class="name-tag__name" picking-mode="Ignore" />
                        <ui:VisualElement name="kit-title-rule" class="kit-title__rule" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="reward-anchor" picking-mode="Ignore">
                    <ui:VisualElement name="reward-card" class="reward-card" picking-mode="Ignore">
                        <ui:Label name="reward-card-title" class="reward-card__title" picking-mode="Ignore" />
                        <ui:VisualElement name="reward-card-lines" class="reward-card__lines" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="unlock-anchor" picking-mode="Ignore">
                    <ui:VisualElement name="unlock-card" class="unlock-card" picking-mode="Ignore">
                        <ui:VisualElement name="unlock-glyph" class="glyph" picking-mode="Ignore">
                            <ui:Label name="unlock-glyph-label" class="glyph__label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="unlock-card__text" picking-mode="Ignore">
                            <ui:Label name="unlock-card-verb" class="unlock-card__verb" picking-mode="Ignore" />
                            <ui:Label name="unlock-card-line" class="unlock-card__line" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="battery-dial" class="battery-dial" picking-mode="Ignore">
                    <ui:VisualElement name="battery-dial-face" class="battery-dial__face" picking-mode="Ignore">
                        <ui:VisualElement name="battery-dial-ring" class="battery-dial__ring" picking-mode="Ignore" />
                        <ui:Label name="battery-dial-value" class="battery-dial__value" picking-mode="Ignore" />
                        <ui:Label class="battery-dial__word loc" text="ui.battery.power" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="next-line" picking-mode="Ignore">
                    <ui:VisualElement name="next-line" class="name-tag" picking-mode="Ignore">
                        <ui:VisualElement name="next-line-shadow" class="soft-shadow soft-shadow--name" />
                        <ui:Label name="next-line-text" class="next-line__text" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="place-card" picking-mode="Ignore">
                    <ui:VisualElement name="place-card" class="name-tag" picking-mode="Ignore">
                        <ui:VisualElement name="place-card-shadow" class="soft-shadow soft-shadow--name" />
                        <ui:Label name="place-card-name" class="name-tag__name" picking-mode="Ignore" />
                        <ui:VisualElement class="place-card__rule" picking-mode="Ignore" />
                        <ui:Label name="place-card-job" class="place-card__job" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="protocol" class="recovery-board protocol-readout" picking-mode="Ignore">
                    <ui:Label name="protocol-title" class="recovery-board__title protocol-readout__title" picking-mode="Ignore" />
                    <ui:VisualElement name="protocol-rows" class="recovery-board__rows" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="recipe-card" class="recipe-card" picking-mode="Ignore">
                    <ui:VisualElement name="recipe-card-shadow" class="soft-shadow soft-shadow--name" />
                    <ui:Label name="recipe-card-title" class="recipe-card__title" picking-mode="Ignore" />
                    <ui:Label name="recipe-card-level" class="recipe-card__level" picking-mode="Ignore" />
                    <ui:VisualElement class="recipe-card__row" picking-mode="Ignore">
                        <ui:Label name="recipe-card-needs-word" class="recipe-card__word" picking-mode="Ignore" />
                        <ui:VisualElement name="recipe-card-needs" class="recipe" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="recipe-card-short" class="recipe__need recipe-card__line" picking-mode="Ignore" />
                    <ui:Label name="recipe-card-part" class="recipe-card__line" picking-mode="Ignore" />
                    <ui:Label name="recipe-card-where" class="recipe-card__where" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="pickup-feed" class="pickup-feed" picking-mode="Ignore" />
                <ui:VisualElement name="ticker" class="ticker" picking-mode="Ignore">
                    <ui:VisualElement name="ticker-line" class="ticker__line" picking-mode="Ignore">
                        <ui:VisualElement name="ticker-lamp" class="ticker__lamp">
                            <ui:VisualElement name="ticker-icon" class="ticker__icon relay-icon" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="ticker-text" class="ticker__text" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="look-hint" class="look-hint" picking-mode="Ignore">
                    <ui:VisualElement class="look-hint__body" picking-mode="Ignore">
                        <ui:VisualElement name="look-hint-shadow" class="soft-shadow soft-shadow--chip" />
                        <ui:VisualElement name="look-hint-chip" class="chip">
                            <ui:VisualElement name="look-hint-glyph" class="glyph">
                                <ui:Label name="look-hint-glyph-label" class="glyph__label" />
                            </ui:VisualElement>
                            <ui:Label name="look-hint-word" class="chip__word" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="dial-readout" class="dial-readout" picking-mode="Ignore">
                    <ui:VisualElement name="dial-readout-frame" class="dial-readout__frame" picking-mode="Ignore">
                        <ui:VisualElement name="dial-readout-shadow" class="soft-shadow soft-shadow--chip" />
                        <ui:VisualElement name="dial-readout-body" class="dial-readout__body" picking-mode="Ignore">
                            <ui:VisualElement name="dial-detents" class="dial-readout__detents" />
                            <ui:Label name="dial-station" class="dial-readout__station" />
                            <ui:Label name="dial-tape" class="dial-readout__tape" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="hop-list" class="hop-list" picking-mode="Ignore">
                    <ui:VisualElement name="hop-list-frame" class="hop-list__frame" picking-mode="Ignore">
                        <ui:VisualElement name="hop-list-shadow" class="soft-shadow soft-shadow--chip" />
                        <ui:VisualElement name="hop-list-rows" class="hop-list__rows" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="memory-card" class="memory-card" picking-mode="Ignore">
                    <ui:VisualElement name="memory-card-shadow" class="soft-shadow soft-shadow--panel" />
                    <ui:VisualElement name="memory-card-body" class="panel memory-card__body">
                        <ui:VisualElement name="memory-card-heading" class="memory-card__heading">
                            <ui:VisualElement name="memory-card-icon" class="cassette-icon memory-card__icon" />
                            <ui:Label name="memory-card-caption" class="caption memory-card__caption" />
                            <ui:Label name="memory-card-count" class="caption caption--quiet memory-card__count" />
                        </ui:VisualElement>
                        <ui:Label name="memory-card-name" class="memory-card__name" />
                        <ui:Label name="memory-card-text" class="memory-card__text" />
                        <ui:VisualElement name="memory-card-footer" class="hint-row">
                            <ui:VisualElement name="memory-card-glyph" class="glyph glyph--small">
                                <ui:Label name="memory-card-glyph-label" class="glyph__label" />
                            </ui:VisualElement>
                            <ui:Label name="memory-card-close" class="hint-row__word" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="tower-panel" class="tower-panel" picking-mode="Ignore">
                    <ui:VisualElement name="tower-panel-shadow" class="soft-shadow soft-shadow--panel" />
                    <ui:VisualElement name="tower-panel-body" class="panel tower-panel__body">
                        <ui:VisualElement class="tower-panel__heading">
                            <ui:VisualElement class="tower-panel__station">
                                <ui:VisualElement class="tower-panel__lamp" />
                                <ui:Label name="tower-name" class="caption tower-panel__name" />
                                <ui:Label name="tower-state" class="caption caption--quiet tower-panel__state" />
                            </ui:VisualElement>
                            <ui:Label name="tower-level" class="caption caption--quiet" />
                        </ui:VisualElement>
                        <ui:Label name="tower-title" class="tower-panel__title" />
                        <ui:Label name="tower-description" class="tower-panel__text" />
                        <ui:VisualElement name="tower-choices" class="tower-panel__choices" />
                        <ui:VisualElement class="tower-panel__footer">
                            <ui:VisualElement name="tower-confirm" class="hold">
                                <ui:VisualElement name="tower-ring" class="hold__ring">
                                    <ui:Label name="tower-ring-glyph" class="hold__glyph" />
                                </ui:VisualElement>
                                <ui:Label name="tower-hold-word" class="hold__word" />
                            </ui:VisualElement>
                            <ui:Label name="tower-need" class="recipe__need tower-panel__need" />
                            <ui:VisualElement name="tower-recipe" class="recipe" />
                            <ui:VisualElement name="tower-pick" class="hint-row tower-panel__pick">
                                <ui:VisualElement name="tower-pick-glyph" class="glyph glyph--small">
                                    <ui:Label name="tower-pick-glyph-label" class="glyph__label" />
                                </ui:VisualElement>
                                <ui:Label name="tower-pick-word" class="hint-row__word" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="lab-hud" class="lab-hud" picking-mode="Ignore">
            <ui:VisualElement class="place-card" picking-mode="Ignore">
                <ui:VisualElement name="lab-place" class="name-tag" picking-mode="Ignore">
                    <ui:VisualElement name="lab-place-shadow" class="soft-shadow soft-shadow--name" />
                    <ui:Label name="lab-place-name" class="name-tag__name" picking-mode="Ignore" />
                    <ui:Label name="lab-place-job" class="place-card__job" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="lab-board" class="recovery-board" picking-mode="Ignore">
                <ui:Label name="lab-board-title" class="recovery-board__title" picking-mode="Ignore" />
                <ui:VisualElement name="lab-board-rows" class="recovery-board__rows" picking-mode="Ignore" />
                <ui:Label name="lab-board-known" class="recovery-board__known" picking-mode="Ignore" />
                <ui:VisualElement name="lab-board-nodes" class="recovery-board__nodes" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="lab-prompts" class="lab-prompts" picking-mode="Ignore">
                <ui:VisualElement name="lab-place-prompt" class="chip lab-prompts__chip" picking-mode="Ignore">
                    <ui:VisualElement name="lab-place-glyph" class="glyph" picking-mode="Ignore">
                        <ui:Label name="lab-place-glyph-label" class="glyph__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="lab-place-word" class="chip__word" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="lab-turn" class="chip lab-prompts__chip" picking-mode="Ignore">
                    <ui:VisualElement class="glyph" picking-mode="Ignore">
                        <ui:Label name="lab-turn-glyph" class="glyph__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="lab-turn-word" class="chip__word" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="lab-look" class="chip lab-prompts__chip" picking-mode="Ignore">
                    <ui:VisualElement class="glyph" picking-mode="Ignore">
                        <ui:Label name="lab-look-glyph" class="glyph__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="lab-look-word" class="chip__word" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="lab-down" class="chip lab-prompts__chip" picking-mode="Ignore">
                    <ui:VisualElement class="glyph" picking-mode="Ignore">
                        <ui:Label name="lab-down-glyph" class="glyph__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="lab-down-word" class="chip__word" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="cargo" class="cargo" picking-mode="Ignore">
            <ui:VisualElement name="cargo-panel" class="cargo__panel" picking-mode="Ignore">
                <ui:VisualElement class="cargo__tabs" picking-mode="Ignore">
                    <ui:VisualElement class="settings-tab-wrap settings-tab-wrap--on" picking-mode="Ignore">
                        <ui:Button name="button-cargo-tab-cargo" class="settings-tab settings-tab--on loc" text="ui.cargo.tab_cargo" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-tab-wrap" picking-mode="Ignore">
                        <ui:Button name="button-cargo-tab-can" class="settings-tab loc" text="ui.cargo.tab_can" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="cargo-page-cargo" class="cargo__page cargo__page--columns" picking-mode="Ignore">
                    <ui:VisualElement class="cargo__column cargo__column--hold" picking-mode="Ignore">
                        <ui:Label class="cargo__heading loc" text="ui.cargo.hold" picking-mode="Ignore" />
                        <ui:Label name="cargo-waiting" class="cargo__note" picking-mode="Ignore" />
                        <ui:VisualElement name="cargo-hold-grid" class="cargo__grid" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cargo__column cargo__column--home" picking-mode="Ignore">
                        <ui:Label class="cargo__heading loc" text="ui.cargo.home" picking-mode="Ignore" />
                        <ui:VisualElement name="cargo-shelves" class="cargo__shelves" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="cargo-page-can" class="cargo__page" picking-mode="Ignore">
                    <ui:VisualElement name="cargo-can-rows" class="cargo__can" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="cargo-summary" class="cargo__summary" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hop-veil" class="hop-veil" picking-mode="Ignore">
            <ui:VisualElement name="hop-veil-dark" class="hop-veil__dark" picking-mode="Ignore" />
            <ui:VisualElement name="hop-veil-grain" class="hop-veil__grain" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="pause" class="pause" picking-mode="Ignore">
            <ui:VisualElement name="pause-veil" class="pause__veil" />
            <ui:VisualElement name="menu-frame" class="safe-frame" picking-mode="Ignore">
                <ui:VisualElement name="title-screen" class="title-screen" picking-mode="Ignore">
                    <ui:VisualElement name="title-wordmark" class="title-screen__wordmark" picking-mode="Ignore" />
                    <ui:Label name="title-subtitle" class="title-screen__subtitle loc" text="ui.title.subtitle" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-frame" class="pause__frame" picking-mode="Ignore">
                    <ui:VisualElement name="pause-stack" class="pause__stack" picking-mode="Ignore">
                        <ui:VisualElement name="pause-main" class="pause__main" picking-mode="Ignore">
                            <ui:VisualElement name="pause-main-shadow" class="soft-shadow soft-shadow--panel" />
                            <ui:VisualElement name="pause-main-body" class="panel pause__panel">
                                <ui:VisualElement class="pause__header">
                                    <ui:VisualElement class="pause__titles">
                                        <ui:Label class="pause__heading loc" text="ui.pause.heading" />
                                        <ui:Label class="pause__subheading loc" text="ui.pause.subheading" />
                                        <ui:VisualElement name="pause-cassettes" class="pause__cassettes">
                                            <ui:VisualElement name="pause-cassette-icon"
                                                              class="cassette-icon cassette-icon--quiet" />
                                            <ui:Label name="pause-cassettes-count" class="pause__cassettes-count" />
                                        </ui:VisualElement>
                                        <ui:VisualElement name="pause-relays" class="pause__cassettes pause__relays">
                                            <ui:VisualElement name="pause-relay-icon" class="relay-icon" />
                                            <ui:Label name="pause-relays-count" class="pause__cassettes-count" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="pause__pages">
                                    <ui:VisualElement name="page-main" class="pause__page">
                                        <ui:Button name="button-resume" class="menu-button" />
                                        <ui:Button name="button-new-game" class="menu-button loc"
                                                   text="ui.title.new_game" />
                                        <ui:Button name="button-settings" class="menu-button loc"
                                                   text="ui.pause.settings" />
                                        <ui:Button name="button-credits" class="menu-button loc"
                                                   text="ui.title.credits" />
                                        <ui:Button name="button-quit-to-title" class="menu-button loc"
                                                   text="ui.pause.quit_to_title" />
                                        <ui:Button name="button-quit" class="menu-button loc" text="ui.pause.quit" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="page-new-game" class="pause__page">
                                        <ui:Label class="pause__question loc" text="ui.title.new_game_question" />
                                        <ui:Label class="pause__aside loc" text="ui.title.new_game_aside" />
                                        <ui:Button name="button-new-game-keep" class="menu-button loc"
                                                   text="ui.title.new_game_keep" />
                                        <ui:Button name="button-new-game-confirm" class="menu-button menu-button--quiet loc"
                                                   text="ui.title.new_game_confirm" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="page-language" class="pause__page" />
                                    <ui:VisualElement name="page-quit" class="pause__page">
                                        <ui:Label class="pause__question loc" text="ui.pause.quit_question" />
                                        <ui:Label class="pause__aside loc" text="ui.pause.quit_aside" />
                                        <ui:Button name="button-quit-stay" class="menu-button loc"
                                                   text="ui.pause.quit_stay" />
                                        <ui:Button name="button-quit-confirm" class="menu-button menu-button--quiet loc"
                                                   text="ui.pause.quit_confirm" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="pause-can" class="pause__can" picking-mode="Ignore">
                                    <ui:Label class="section-label loc" text="ui.pause.can" />
                                    <ui:VisualElement name="pause-can-rows" class="pause__can-rows" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="pause-settings" class="pause__settings" picking-mode="Ignore">
                            <ui:VisualElement name="pause-settings-shadow" class="soft-shadow soft-shadow--panel" />
                            <ui:VisualElement name="pause-settings-body" class="panel pause__panel pause__panel--settings">
                                <ui:VisualElement name="settings-tabs" class="settings-tabs" picking-mode="Ignore">
                                    <ui:VisualElement class="settings-tab-wrap settings-tab-wrap--on" picking-mode="Ignore">
                                        <ui:Button name="button-tab-sound" class="settings-tab settings-tab--on loc" text="ui.settings.sound" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="settings-tab-wrap" picking-mode="Ignore">
                                        <ui:Button name="button-tab-camera" class="settings-tab loc" text="ui.settings.tab_camera" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="settings-tab-wrap" picking-mode="Ignore">
                                        <ui:Button name="button-tab-display" class="settings-tab loc" text="ui.settings.tab_display" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="settings-page-sound" class="settings-page">
                                <ui:VisualElement class="setting-row">
                                    <ui:Label class="setting-row__label loc" text="ui.settings.master" />
