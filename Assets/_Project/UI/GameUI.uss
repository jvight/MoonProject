/*
 * Lunarion UI — Variant C ("Terminal hai màu", 0.5.7): 07's warm amber CRT screen (--moon-*, --glass-*) paired with a
 * calm cyan telemetry/scan accent (--crt-cyan-*), warm coral shortages (--moon-warm-accent), and warm off-white paper
 * with dark ink (--paper-*) for crew documents. Type is IBM Plex Mono for terminal body/readouts, Chakra Petch for
 * display headings and hero numbers, and Be Vietnam Pro for crew documents.
 */

.moon-root,
.hud,
.pause,
.pause__veil,
.title-crt,
.title-crt-overlay,
.pause__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* A safe frame fills the screen until SafeFrame insets it (an ultra-wide screen, a device's unsafe edges) */
.safe-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.moon-root {
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.pause__heading,
.chip__number,
.name-tag__name,
.glyph__label,
.material-slot__count {
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
    font-size: 22px;
}

.chip__word,
.caption,
.section-label,
.next-line__text,
.material-slot__word,
.pause .menu-button {
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

Label {
    color: var(--moon-text);
    margin: 0;
    padding: 0;
}

/* Soft shadows (painted, see ShadowPainter): an absolutely positioned layer behind each panel. */

.soft-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --shadow-color: var(--moon-shadow);
    --shadow-offset: 6;
    --shadow-layers: 8;
    --shadow-radius: 22;
    --shadow-spread: 18;
}

/* Glass panels carry their own soft rim glow (UI/Glass), so their shadow layer stays empty */
.soft-shadow--panel {
    display: none;
}

/* CRT panels and chips */

/* Variant C CRT: the dark phosphor screen, amber bezel, corner ticks and scanlines are one 9-sliced texture at 2x */
.panel {
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPanel.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.5;
    padding: 22px 26px 20px 26px;
}

.chip {
    flex-direction: row;
    align-items: center;
    padding: 7px 18px 7px 8px;
    border-radius: 10px;
    background-color: var(--moon-glass);
    border-width: 1.5px;
    border-color: var(--moon-glass-edge);
}

.chip__word {
    font-size: 26px;
    color: var(--moon-text);
}

/* The prompt: the key's badge, then the action on its own CRT pill */
.prompt .chip {
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.prompt .chip__word {
    padding: 4px 20px 6px 20px;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: var(--glass-rim);
    background-color: var(--moon-glass);
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Bold.asset");
}

.chip__number {
    font-size: 22px;
    margin-left: 8px;
    min-width: 24px;
}

.caption {
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--moon-warm-lamp);
}

.caption--quiet {
    color: var(--moon-text-faint);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

/* Glyphs: a key cap for keys and mouse buttons, a round button for gamepads */

/* A key or button: a round CRT keycap bubble with a bright amber rim and the key in Chakra Petch (Variant C) */
.glyph {
    min-width: 44px;
    height: 44px;
    padding: 0 12px;
    margin-right: 10px;
    border-radius: 22px;
    border-width: 2px;
    border-color: var(--glass-rim);
    background-color: var(--glass-bubble);
    justify-content: center;
    align-items: center;
}

.glyph--pad {
    min-width: 44px;
    width: 44px;
    padding: 0;
    border-radius: 22px;
}

.glyph__label {
    font-size: 20px;
    color: var(--glass-hi);
    -unity-text-align: middle-center;
}

/* A hold verb's keycap ring: faint at rest, so the key reads as one you hold; it fills while the hold runs. */
.glyph__hold-ring {
    position: absolute;
    left: -6px;
    top: -6px;
    right: -6px;
    bottom: -6px;
    --track-color: var(--moon-amber-soft);
    --fill-color: var(--glass-hi);
    --ring-width: 2.5;
}

.glyph--small {
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    margin-right: 8px;
    border-radius: 8px;
}

.glyph--small.glyph--pad {
    min-width: 30px;
    width: 30px;
    padding: 0;
    border-radius: 15px;
}

.glyph--small .glyph__label {
    font-size: 18px;
}

/* Salvage materials (painted, see MaterialIconPainter), in art's bundle colours: steel, copper, violet */

.material-slot {
    flex-direction: row;
    align-items: center;
    margin: 0 6px;
}

.material-icon {
    width: 24px;
    height: 24px;
    --icon-hole-color: var(--moon-sky-top);
}

.material-icon--metal {
    --icon-color: var(--moon-metal);
    --icon-detail: var(--moon-text-faint);
}

.material-icon--wiring {
    --icon-color: var(--moon-warm-accent);
    --icon-detail: var(--moon-warm-lamp);
}

.material-icon--circuit_chips {
    --icon-color: rgb(63, 174, 122);
    --icon-detail: rgb(191, 238, 218);
}

.material-icon--orange_beads {
    --icon-color: rgb(255, 154, 60);
    --icon-detail: rgb(255, 217, 168);
}

.material-icon--ilmenite {
    --icon-color: rgb(110, 120, 146);
    --icon-detail: rgb(190, 198, 218);
}

.material-icon--water_ice {
    --icon-color: rgb(159, 217, 255);
    --icon-detail: rgb(255, 255, 255);
}

.material-icon--rare_earths {
    --icon-color: rgb(200, 139, 255);
    --icon-detail: rgb(239, 217, 255);
}

.material-icon--glass {
    --icon-color: rgb(255, 207, 122);
    --icon-detail: rgb(255, 241, 207);
}

.material-icon--alloy {
    --icon-color: rgb(140, 168, 212);
    --icon-detail: rgb(222, 234, 255);
}

.material-icon--coolant {
    --icon-color: rgb(94, 230, 214);
    --icon-detail: rgb(214, 255, 249);
}

.material-icon--crystal {
    --icon-color: rgb(255, 127, 192);
    --icon-detail: rgb(255, 214, 236);
}

.material-icon--superconductor {
    --icon-color: rgb(255, 228, 94);
    --icon-detail: rgb(255, 246, 184);
}

.material-icon--optics {
    --icon-color: var(--moon-sky-horizon);
    --icon-detail: var(--moon-metal);
}

.material-slot__count {
    font-size: 20px;
    margin-left: 6px;
    min-width: 14px;
    color: var(--moon-text);
}

/* A recipe, one row per material (docs/design/first-hour-v2 6.5): icon, name, the need and what 07 has, a check once
   it is covered; a short one reads dim. One quiet need line under them. */

.recipe {
    flex-direction: column;
    align-items: flex-start;
}

.recipe .material-icon {
    width: 24px;
    height: 24px;
}

.recipe .material-slot {
    margin: 3px 0;
}

.material-slot__word {
    min-width: 92px;
    margin-left: 10px;
    font-size: 22px;
    color: var(--moon-text);
}

.recipe .material-slot__count {
    margin-left: 6px;
    font-size: 22px;
    white-space: nowrap;
}

/* A covered material wears a painted check (the fonts have none); a short one reads warm coral, with no check */
.material-slot__check {
    width: 18px;
    height: 18px;
    margin-left: 8px;
    --check-color: var(--moon-warm-lamp);
}

.material-slot--short .material-slot__check {
    display: none;
}

.material-slot--short .material-icon {
    opacity: 0.85;
}

.material-slot--short .material-slot__count,
.material-slot--short .material-slot__word {
    color: var(--moon-warm-accent);
}

/* The title over the live world (M3-09): anchored left-column composition inside the CRT bezel */

.pause--title .safe-frame {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-left: 72px;
}

.title-screen {
    position: relative;
    left: 0;
    top: 0;
    width: 470px;
    flex-shrink: 0;
    align-items: flex-start;
}

/* Drawn by WordmarkPainter from the approved SVG; its height follows its width */
.title-screen__wordmark {
    width: 440px;
    margin-left: -26px;
    --ink-color: var(--moon-cream);
    --glow-color: var(--moon-amber-soft);
    --glow-width: 18;
}

.title-screen__subtitle-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-left: 4px;
}

.title-screen__subtitle-prefix {
    font-size: 20px;
    letter-spacing: 0.5px;
    color: var(--moon-text-dim);
    margin-right: 4px;
    -unity-text-align: middle-left;
}

.title-screen__subtitle {
    margin-top: 0;
    font-size: 20px;
    letter-spacing: 0.5px;
    color: var(--moon-text-dim);
    -unity-text-align: middle-left;
}

.title-screen__rule {
    width: 470px;
    height: 2px;
    margin-top: 10px;
    background-color: var(--glass-rim-glow);
    border-left-width: 48px;
    border-left-color: var(--moon-warm-lamp);
}

.title-key-hint {
    position: relative;
    left: 0;
    bottom: 0;
    flex-shrink: 0;
    margin-left: 4px;
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--moon-text-dim);
    -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.pause--title .pause__veil,
.pause--title .pause__header {
    display: none;
}

.pause--title .pause__frame {
    position: relative;
    left: auto;
    top: auto;
    right: auto;
    bottom: auto;
    width: 470px;
    height: 396px;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: center;
    align-items: flex-start;
    padding: 0;
    margin: 10px 0;
}

.pause--title .pause__stack {
    width: 470px;
}

.pause--title.pause--settings-open .pause__frame,
.pause--title.pause--settings-open .pause__stack {
    width: 510px;
}

.pause--title .pause__pages {
    min-height: 0;
}

.pause--title .pause__main .pause__panel {
    background-image: none;
    padding: 0;
}

.pause--title .pause__main .menu-button {
    height: 48px;
    margin: 4px 0;
    padding: 0 18px 0 42px;
    border-radius: 5px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 6px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--glass-hi);
    font-size: 28px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Bold.asset");
}

.pause--title .pause__main .menu-button:focus,
.pause--title .pause__main .menu-button:active {
    background-color: var(--crt-cyan-fill);
    border-color: var(--moon-tech-glow);
    color: var(--moon-tech-glow);
    scale: 1 1;
}

.menu-button__cursor {
    position: absolute;
    left: 14px;
    top: 0;
    bottom: 0;
    display: none;
    font-size: 28px;
    color: var(--moon-tech-glow);
    -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Bold.asset");
}

.pause .menu-button:focus .menu-button__cursor,
.credits__panel .menu-button:focus .menu-button__cursor,
.setting-row--focused .menu-button__cursor,
.settings-tab-wrap--focus .menu-button__cursor {
    display: flex;
}

.setting-row .menu-button__cursor {
    left: 6px;
    font-size: 22px;
}

.settings-tab-wrap .menu-button__cursor {
    left: 6px;
    font-size: 18px;
}

.menu-button__note {
    position: absolute;
    right: 16px;
    top: 0;
    bottom: 0;
    display: none;
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--moon-text-faint);
    -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.pause--title .pause__main .menu-button .menu-button__note {
    display: flex;
}

.pause--title .pause__main .menu-button:focus .menu-button__note {
    color: var(--crt-cyan-dim);
}

/* Title settings sub-screen: occupies the same anchored left-column slot as the title menu */
.pause--title .pause__settings {
    position: relative;
    left: 0;
    top: 0;
    bottom: auto;
    width: 510px;
    margin-left: 0;
}

.pause--title .pause__panel--settings {
    padding: 12px 18px 10px 18px;
}

.pause--title .settings-tabs {
    margin: 0 0 8px 0;
}

.pause--title .settings-tab-wrap,
.pause--title .settings-tab {
    min-height: 36px;
    font-size: 18px;
}

.pause--title .settings-tab {
    padding: 2px 10px 2px 18px;
}

.pause--title .settings-tab-wrap--focus {
    --tab-color: var(--crt-cyan-fill);
    --tab-edge: var(--moon-tech-glow);
    scale: 1 1;
}

.pause--title .settings-tab-wrap--focus .settings-tab {
    color: var(--moon-tech-glow);
}

.pause--title .settings-page {
    min-height: 244px;
}

.pause--title .setting-row {
    min-height: 38px;
    margin: 1px 0;
    padding-left: 24px;
}

.pause--title .setting-row__label {
    width: 206px;
    font-size: 22px;
}

.pause--title .menu-button--compact {
    height: 34px;
    font-size: 20px;
}

.pause--title .pause__panel--settings .menu-button--quiet,
.pause--title .credits__panel .menu-button--quiet {
    height: 42px;
    margin-top: 6px;
    margin-bottom: 0;
    padding: 0 18px 0 42px;
    border-radius: 5px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 6px;
    border-color: var(--glass-rim);
    background-color: var(--moon-glass);
    color: var(--glass-hi);
    font-size: 22px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Bold.asset");
}

.pause--title .pause__panel--settings .menu-button--quiet:focus,
.pause--title .pause__panel--settings .menu-button--quiet:active,
.pause--title .credits__panel .menu-button--quiet:focus,
.pause--title .credits__panel .menu-button--quiet:active {
    background-color: var(--crt-cyan-fill);
    border-color: var(--moon-tech-glow);
    color: var(--moon-tech-glow);
    scale: 1 1;
}

.pause--title .pause__question,
.pause--title .pause__aside {
    white-space: normal;
}

/* The save tick: a tiny cream "07" and check mark in the bottom corner, only for a moment after a real save */
.save-tick {
    position: absolute;
    right: 34px;
    bottom: 30px;
    flex-direction: row;
    align-items: center;
}

.save-tick__word {
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--moon-text);
    text-shadow: 0 2px 10px var(--moon-shadow);
}

.save-tick__check {
    width: 20px;
    height: 20px;
    margin-left: 8px;
    --tick-color: var(--moon-cream);
}

/* The credits: a centred glass panel over the title, its text drifting up slowly */
.credits {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.credits__panel {
    width: 46%;
    min-width: 520px;
    max-width: 680px;
    height: 76%;
    padding: 24px 32px 20px 32px;
}

.credits__title {
    margin-bottom: 14px;
    font-size: 30px;
    letter-spacing: 4px;
    color: var(--glass-hi);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

.credits__scroll {
    flex-grow: 1;
    margin-bottom: 12px;
}

.credits__heading {
    margin-top: 30px;
    margin-bottom: 8px;
    font-size: 24px;
    letter-spacing: 3px;
    color: var(--glass-sel);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-Bold.asset");
}

.credits__version {
    margin-bottom: 14px;
    font-size: 18px;
    color: var(--moon-text-dim);
    -unity-text-align: middle-center;
}

.credits__name {
    margin-top: 10px;
    font-size: 22px;
    color: var(--glass-hi);
    white-space: normal;
    -unity-text-align: middle-center;
}

.credits__detail {
    font-size: 18px;
    color: var(--glass-ring);
    white-space: normal;
    -unity-text-align: middle-center;
}

.credits__note {
    font-size: 18px;
    color: var(--moon-text-dim);
    white-space: normal;
    -unity-text-align: middle-center;
}

.curtain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--moon-sky-top);
}

/* The Outsight Worlds splash on the boot's dark (BootSplashView): four layers stacked in one centred square. */

.boot-splash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.boot-splash__square {
    position: relative;
}

.boot-splash__layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.boot-splash__clip {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    overflow: hidden;
}

/*
 * Floating names (the next line): cream type on a soft dusk of
 * shadow and no plate, so each reads even over the bright Earth or a lit sky. One look for every name.
 */

.name-tag {
    align-items: center;
    padding: 4px 10px 6px 10px;
}

.soft-shadow--name {
    --shadow-offset: 0;
    --shadow-radius: 30;
    --shadow-spread: 56;
    --shadow-layers: 10;
}

.name-tag__name {
    font-size: 34px;
    letter-spacing: 2px;
    color: var(--glass-hi);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 14px var(--moon-shadow);
}

/* The soft "next" line: the current step's invitation, high and quiet, only while 07 is still */

.next-line {
    position: absolute;
    left: 0;
    top: 8px;
    align-items: flex-start;
}

/* The distance home at the top centre, in Variant C's calm cyan telemetry accent */

.next-line__text {
    font-size: 26px;
    letter-spacing: 1px;
    color: var(--moon-text);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 12px var(--moon-shadow);
}

/* After its bright rest the objective line is a small dim line (docs/design/opening-v2.md §3) */
.next-line--dim .next-line__text {
    font-size: 18px;
    opacity: 0.7;
}

/* The weld's bar under the build step's line: a calm cyan fill on an amber track */
.next-line__progress {
    align-self: stretch;
    height: 6px;
    margin-top: 8px;
    border-radius: 3px;
    background-color: var(--moon-track);
}

.next-line__progress-fill {
    width: 0;
    height: 6px;
    border-radius: 3px;
    background-color: var(--crt-cyan-dim);
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-sine;
}

/* 07's cells (docs/design/first-hour-v2 6.4): a small row of pills on a glass plate, top left, one pill per cell */

/* The battery dial at the bottom left */
.battery-dial {
    position: absolute;
    left: 100px;
    bottom: 69px;
    width: 142px;
    height: 142px;
}

.battery-dial__face {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassDial.png");
}

.battery-dial__ring {
    position: absolute;
    left: 13px;
    top: 13px;
    right: 13px;
    bottom: 13px;
    --track-color: var(--moon-track);
    --fill-color: var(--glass-ring);
    --low-color: var(--moon-warm-accent);
    --ring-width: 9;
}

.battery-dial__value {
    font-size: 38px;
    color: var(--glass-hi);
    -unity-text-align: middle-center;
}

/* Every line sits on a CRT plate (docs/design/first-hour-v2 6.2): the next line */

.next-line .name-tag {
    padding: 12px 30px 14px 30px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPill.png");
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 72;
    -unity-slice-bottom: 72;
    -unity-slice-scale: 0.5;
}

/* The unlock card: a kit has just been fitted; its key, its word and one line of what it lets 07 do */

.unlock-anchor {
    position: absolute;
    left: 0;
    right: 0;
    top: 20%;
    align-items: center;
}

.unlock-card {
    flex-direction: row;
    align-items: center;
    min-width: 440px;
    max-width: 700px;
    padding: 18px 32px 18px 26px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPanel.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.5;
}

.unlock-card__text {
    margin-left: 22px;
    flex-shrink: 1;
}

.unlock-card__verb {
    font-size: 28px;
    letter-spacing: 2px;
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

/* Context prompt: anchored to a projected world point, centred above it */

.world-anchor {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

.world-anchor__center {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -100%;
}

/*
 * The pickup feed (Subnautica's pickup notices): small glass rows at the left, one per material that just grew, each
 * with its icon, name, a "+N" and the new total. A row slides in from the left (PickupFeedSettings.SlideDistance).
 */

.pickup-feed {
    position: absolute;
    left: 0;
    top: 36%;
    align-items: flex-start;
}

.pickup-row {
    margin-bottom: 8px;
}

.pickup-row__body {
    flex-direction: row;
    align-items: center;
    min-width: 280px;
    padding: 9px 22px 9px 18px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPill.png");
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 72;
    -unity-slice-bottom: 72;
    -unity-slice-scale: 0.5;
}

.pickup-row .material-icon {
    width: 26px;
    height: 26px;
    margin-right: 12px;
}

.pickup-row__part-icon {
    width: 34px;
    height: 34px;
    margin-right: 12px;
}

.pickup-row__name {
    flex-grow: 1;
    margin-right: 16px;
    font-size: 20px;
    color: var(--glass-hi);
}

.pickup-row__plus,
.pickup-row__gain {
    font-size: 24px;
    color: var(--glass-sel);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-Bold.asset");
}

.pickup-row__gain {
    min-width: 34px;
    margin-right: 18px;
}

.pickup-row__total {
    min-width: 36px;
    font-size: 22px;
    color: var(--moon-text-dim);
    -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

/* Salvage: the hold ring centred on a piece's cut point, and a site's name over it */

.world-anchor__middle {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
}

.salvage-ring {
    width: 48px;
    height: 48px;
    justify-content: center;
    align-items: center;
    border-radius: 24px;
    background-color: var(--moon-glass);
    --track-color: var(--moon-track);
    --fill-color: var(--moon-warm-lamp);
    --charge-color: var(--moon-cream);
    --ring-width: 3.5;
}

.salvage-ring__icon {
    width: 20px;
    height: 20px;
}

/* The one-time Look up hint: the prompt chip's look, low and centred, above the next line */

.look-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

/* The first controls card: one small, quiet glass row in the bottom-left corner, below the battery dial */

.controls-card {
    position: absolute;
    left: 0;
    bottom: 0;
}

.controls-card__chip {
    padding: 5px 14px 5px 6px;
}

.controls-card__word {
    font-size: 19px;
}

.controls-card__dot {
    width: 4px;
    height: 4px;
    margin: 0 12px;
    border-radius: 2px;
    background-color: var(--moon-text-faint);
}

.controls-card .glyph--small.glyph--pad {
    width: auto;
    padding: 0 8px;
}

/* Pause menu */

.pause__veil {
    background-color: var(--moon-veil);
}

.pause__frame {
    justify-content: center;
    align-items: center;
}

.pause__stack {
    width: 410px;
}

.pause__settings {
    position: absolute;
    left: 100%;
    top: 0;
    width: 510px;
    margin-left: 26px;
}

.pause__panel {
    padding: 28px 28px 22px 28px;
}

/* The menu's title bar: a band of brighter amber CRT across the panel's top, the heading in Chakra Petch capitals */
.pause__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin: -16px -20px 18px -20px;
    padding: 12px 28px 12px 28px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    background-color: var(--glass-bar);
}

.pause__heading {
    font-size: 30px;
    letter-spacing: 4px;
    color: var(--glass-hi);
}

.pause__subheading {
    font-size: 18px;
    color: var(--moon-text-faint);
    margin-top: 4px;
}

.pause__pages {
    min-height: 196px;
}

.pause__question {
    font-size: 23px;
    margin-top: 6px;
    padding-left: 8px;
}

.pause__aside {
    font-size: 18px;
    color: var(--moon-text-dim);
    margin-top: 4px;
    margin-bottom: 14px;
    padding-left: 8px;
    white-space: normal;
}

.pause .menu-button {
    height: 50px;
    margin: 5px 0;
    padding: 0 18px;
    border-radius: 13px;
    border-width: 1px;
    border-color: var(--glass-rim);
    background-color: var(--glass-btn);
    color: var(--glass-hi);
    font-size: 22px;
    -unity-text-align: middle-center;
}

.pause .menu-button--quiet {
    color: var(--moon-text);
    background-color: var(--moon-glass);
}

.pause .menu-button--compact {
    flex-grow: 1;
    height: 38px;
    margin: 0 6px;
    padding: 0 12px;
    font-size: 20px;
    border-radius: 12px;
    border-color: var(--glass-rim);
    background-color: var(--glass-btn);
    -unity-text-align: middle-center;
}

/* The settings list has grown to a dozen rows: a little less padding keeps it on screen at the largest text size */
.pause__panel--settings {
    padding: 18px 22px 14px 22px;
}

.pause__panel--settings .menu-button--quiet {
    margin-top: 12px;
    padding-left: 4px;
}

/* Focus swells 4% over 120 ms; a press dips to 98% in 60 ms and comes back over 140 (feel-pass 2.12) */
.pause .menu-button {
    transform-origin: 50% 50%;
    transition-property: scale, background-color;
    transition-duration: 0.14s, 0.14s;
    transition-timing-function: ease-out;
}

/* Selection is an amber fill with dark text and a warm glow, as in the mockup */
.pause .menu-button:focus {
    background-color: var(--glass-sel);
    border-color: var(--glass-sel);
    color: var(--glass-sel-text);
    scale: 1.04 1.04;
    transition-duration: 0.12s, 0.12s;
}

.pause .menu-button:active {
    background-color: var(--glass-sel);
    color: var(--glass-sel-text);
    scale: 0.98 0.98;
    transition-duration: 0.06s, 0.06s;
}

.pause--title .menu-button--compact:focus,
.pause--title .menu-button--compact:active {
    background-color: var(--crt-cyan-fill);
    border-color: var(--moon-tech-glow);
    color: var(--moon-tech-glow);
    scale: 1 1;
}

/* The settings' tabs: chamfered CRT terminal tabs (Variant C), the selected one edged in amber */
.settings-tabs {
    flex-direction: row;
    align-items: stretch;
    margin: 0 0 12px 0;
}

/* Each tab's chamfered CRT frame is painted on its wrapper, beneath the button, so the label is always drawn on top */
.settings-tab-wrap {
    flex-grow: 1;
    flex-basis: auto;
    flex-shrink: 0;
    min-width: 0;
    min-height: 40px;
    margin: 0 2px;
    --tab-color: var(--glass-deep);
    --tab-edge: var(--moon-track);
    --tab-edge-width: 1.5;
}

.settings-tab-wrap--on {
    --tab-color: var(--glass-bar);
    --tab-edge: var(--glass-sel);
    --tab-edge-width: 3;
}

.settings-tab-wrap--focus {
    --tab-color: var(--glass-sel);
    --tab-edge: var(--glass-sel);
    scale: 1.04 1.04;
}

.settings-tab {
    flex-grow: 1;
    min-width: 0;
    min-height: 40px;
    margin: 0;
    padding: 2px 10px 2px 18px;
    white-space: nowrap;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--glass-hi);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.settings-tab-wrap--focus .settings-tab {
    color: var(--glass-sel-text);
}

.settings-page {
    min-height: 244px;
}

/* A choice stepped by a pair of arrows round its current value (resolution, window mode, FPS limit) */
.cycle__arrow {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 34px;
    margin: 0 2px;
    padding: 0;
}

.cycle__value {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 20px;
    white-space: normal;
    color: var(--glass-hi);
    -unity-text-align: middle-center;
}

.setting-row--idle {
    opacity: 0.5;
}

.section-label {
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--moon-warm-lamp);
    margin-top: 16px;
    margin-bottom: 4px;
    padding-left: 4px;
}

.section-label--first {
    margin-top: 0;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 0 6px 0 24px;
    border-radius: 5px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 5px;
    border-color: rgba(0, 0, 0, 0);
}

.setting-row--focused {
    background-color: var(--crt-cyan-fill);
    border-color: var(--moon-tech-glow);
}

.setting-row--focused .setting-row__label,
.setting-row--focused .setting-row__value,
.setting-row--focused .cycle__value {
    color: var(--moon-tech-glow);
}

/* A fixed label column wide enough for the longest label in English and Vietnamese; a longer one wraps */
.setting-row__label {
    width: 206px;
    flex-shrink: 0;
    margin-right: 6px;
    font-size: 22px;
    white-space: normal;
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.setting-row__slider {
    flex-grow: 1;
    margin: 0 8px;
}

.setting-row__value {
    width: 58px;
    font-size: 20px;
    color: var(--moon-text);
    -unity-text-align: middle-right;
}

.pause .unity-base-slider__tracker {
    height: 5px;
    margin-top: -2px;
    border-width: 0;
    border-radius: 3px;
    background-color: var(--moon-track);
}

.pause .unity-base-slider__fill {
    border-radius: 3px;
    background-color: var(--glass-ring);
}

.pause .unity-base-slider__dragger {
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-width: 2px;
    border-radius: 11px;
    border-color: var(--glass-rim-glow);
    background-color: var(--glass-hi);
}

.pause .unity-base-slider__dragger-border {
    display: none;
}

.pause .unity-base-slider:focus .unity-base-slider__dragger {
    border-color: var(--moon-tech-glow);
    background-color: var(--moon-tech-glow);
}

.pause .unity-base-slider:focus .unity-base-slider__fill {
    background-color: var(--moon-tech-glow);
}

.pause .unity-toggle__checkmark {
    width: 26px;
    height: 26px;
    border-width: 1px;
    border-radius: 7px;
    border-color: var(--glass-rim);
    background-color: var(--moon-glass);
    -unity-background-image-tint-color: var(--glass-sel-text);
}

.pause .unity-toggle:focus .unity-toggle__checkmark {
    border-color: var(--moon-tech-glow);
    border-width: 2px;
}

.pause .unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--glass-ring);
}

/*
 * 07's readout (docs/design/opening-v2.md section 10): the boot diagnostics, the protocol line, the lander's reserve,
 * one system's line and a scanned panel's text, one card at a time on a CRT plate high on the left over the dark sky.
 * Mono type, so the dotted leaders line up; a broken part reads warm, one that waits reads dim.
 */

.readout {
    position: absolute;
    left: 0;
    top: 16%;
    padding: 18px 26px 16px 26px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPanel.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.5;
}

.readout__line {
    font-size: 18px;
    white-space: nowrap;
    color: var(--moon-cream);
    text-shadow: 0 2px 12px var(--moon-shadow);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.readout__line--fault {
    color: var(--moon-warm-accent);
}

.readout__line--dim {
    color: var(--moon-text-dim);
}

/* A line that just changed, or refused, lights up and dies down again */
.readout__line--flash {
    color: var(--glass-hi);
    background-color: var(--moon-cream-glow);
}

/* The Sun's arc at the top right: what is left of the Sun over the rim, the world's only clock */

.sun-arc {
    position: absolute;
    right: 100px;
    top: 69px;
    width: 96px;
    align-items: flex-end;
}

.sun-arc__face {
    width: 96px;
    height: 96px;
    --track-color: var(--moon-track);
    --fill-color: var(--moon-warm-lamp);
    --ring-width: 6;
}

/* How long the Sun has left, under its arc: shown only while it is really going down. */
.sun-arc__time {
    display: none;
    margin-top: 2px;
    font-size: 18px;
    white-space: nowrap;
    -unity-text-align: upper-right;
    color: var(--moon-text);
    text-shadow: 0 2px 12px var(--moon-shadow);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.sun-arc__label {
    margin-top: 4px;
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--moon-text-dim);
    text-shadow: 0 2px 12px var(--moon-shadow);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

/*
 * Build strip & ghost placement reason (0.5.7 slice 6, BUILD-MODE, Variant C CRT):
 * Two-colour amber & cyan CRT terminal strip with line-art structure icons, Chakra Petch structure names,
 * and IBM Plex Mono cost icons only.
 */

.build-strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 22px;
    align-items: center;
}

/* Compact: the panel hugs its cards (one row for a few structures, wrapping only past the safe width) */
.build-strip__body {
    max-width: 1100px;
    padding: 12px 18px 10px 18px;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: var(--glass-rim);
    background-color: var(--moon-glass);
}

.build-strip__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 0 6px 4px 6px;
}

.build-strip__title {
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

.build-strip__status {
    margin-left: 32px;
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--glass-sel);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.build-strip--short .build-strip__status {
    color: var(--moon-warm-accent);
}

.build-strip__cards {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    margin-bottom: 0;
}

.build-card {
    width: 196px;
    padding: 10px 12px 9px 12px;
    margin: 5px;
    border-radius: 7px;
    border-width: 1.5px;
    border-color: var(--moon-track);
    background-color: var(--glass-deep);
    align-items: center;
    justify-content: space-between;
}

/* The pointer over a card: its rim lights before the hover selects it */
.build-card:hover {
    border-color: var(--glass-rim);
}

.build-card--selected {
    border-width: 3px;
    border-color: var(--crt-cyan-edge);
    background-color: var(--crt-cyan-fill);
}

.build-card--short {
    border-color: var(--crt-coral-edge);
    background-color: var(--crt-coral-fill);
    opacity: 0.78;
}

.build-card--selected.build-card--short {
    border-color: var(--crt-cyan-edge);
    background-color: var(--crt-cyan-fill);
    opacity: 0.94;
}

.build-card__icon {
    width: 56px;
    height: 56px;
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--moon-warm-lamp);
}

.build-card--selected .build-card__icon {
    -unity-background-image-tint-color: var(--crt-cyan-dim);
}

.build-card--short .build-card__icon {
    -unity-background-image-tint-color: var(--moon-text-faint);
}

.build-card--selected.build-card--short .build-card__icon {
    -unity-background-image-tint-color: var(--crt-cyan-dim);
}

.build-card__name {
    font-size: 20px;
    color: var(--moon-text);
    white-space: nowrap;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

.build-card--selected .build-card__name {
    color: var(--crt-cyan-dim);
}

.build-card__cost {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.build-card__cost .material-slot {
    margin: 0 5px;
    flex-direction: row;
    align-items: center;
}

.build-card__cost .material-icon {
    width: 20px;
    height: 20px;
}

.build-card__cost .material-slot__count {
    min-width: 0;
    margin-left: 4px;
    font-size: 18px;
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Bold.asset");
}

.build-card--selected .build-card__cost .material-slot__count {
    color: var(--crt-cyan-dim);
}

.build-card__cost .material-slot--short .material-slot__count {
    color: var(--moon-warm-accent);
}

/* The share of 07's battery the weld takes, under the materials: the calm cyan telemetry accent */
.build-card__energy {
    margin-top: 4px;
    font-size: 18px;
    color: var(--crt-cyan-dim);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.build-strip__detail {
    display: none;
}

.build-strip__info {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 22px;
}

.build-strip__name {
    font-size: 20px;
    color: var(--crt-cyan-dim);
    margin-bottom: 0;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

.build-strip__desc {
    display: none;
    font-size: 16px;
    color: var(--moon-text-dim);
    white-space: normal;
}

.build-strip__recipe {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* The key row under the cards: what picks, what leaves, on the active device */
.build-strip__footer {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 8px;
}

.build-strip__hint-item {
    flex-direction: row;
    align-items: center;
    margin: 0 18px;
}

.build-strip__hint-item .glyph--small.glyph--pad {
    width: auto;
    padding: 0 8px;
}

.build-strip__hint {
    font-size: 18px;
    color: var(--moon-text-dim);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.build-reason__body {
    padding: 6px 18px 7px 18px;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: var(--crt-coral-edge);
    background-color: var(--crt-coral-fill);
}

.build-reason__text {
    font-size: 22px;
    color: var(--moon-warm-accent);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

/*
 * The cargo screen (Tab / View): FaceInventoryView (1152x768, 1.5:1), look A "quiet amber CRT": warm neutrals and one
 * amber accent on the tube's dark, three text sizes (title 28, body 22, meta 18) and nothing drawn that carries
 * nothing. The hold grid and its info box on the left, 07's line drawing with its four device bays on the right.
 */

.cargo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

.cargo__panel {
    width: 1152px;
    height: 768px;
    background-color: rgba(0, 0, 0, 0);
}

.cargo__art {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.cargo__canvas,
.cargo__grid,
.cargo__sockets {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cargo__heading {
    position: absolute;
    font-size: 28px;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    color: rgb(248, 238, 214);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

.cargo__page {
    position: absolute;
    font-size: 18px;
    -unity-text-align: middle-right;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.cargo__boot {
    display: none;
    position: absolute;
    font-size: 28px;
    letter-spacing: 1px;
    color: rgb(248, 238, 214);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

.cargo__cell {
    position: absolute;
}

.cargo__badge {
    display: none;
    position: absolute;
    right: 4px;
    bottom: 0;
    font-size: 18px;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

/* The small accent badge on the top edge of a part that can be fitted right now, on the tube's dark: where it goes
   ("-> Cutter"). On the edge, never stacked with the name under the cell. */
.cargo__tag {
    display: none;
    position: absolute;
    left: -18px;
    right: -18px;
    top: -11px;
    height: 22px;
    border-width: 1.5px;
    border-radius: 4px;
    border-color: rgb(255, 196, 96);
    font-size: 18px;
    -unity-text-align: middle-center;
    background-color: rgb(19, 18, 16);
    color: rgb(255, 196, 96);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.cargo__cell-name {
    display: none;
    position: absolute;
    overflow: hidden;
    white-space: normal;
    padding: 0;
    font-size: 18px;
    -unity-text-align: upper-center;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.cargo__cell-name--on {
    color: rgb(224, 210, 182);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.cargo__socket-bubble {
    position: absolute;
}

.cargo__device-name {
    position: absolute;
    font-size: 22px;
    -unity-text-align: middle-left;
    color: rgb(224, 210, 182);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.cargo__device-state {
    position: absolute;
    font-size: 18px;
    white-space: normal;
    -unity-text-align: upper-left;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.cargo__device-state--accent {
    color: rgb(255, 196, 96);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

/* The bays right of 07 set their words against their outer edge, the way the screen's right column reads. */
.cargo__socket-bubble--right .cargo__device-name {
    -unity-text-align: middle-right;
}

.cargo__socket-bubble--right .cargo__device-state {
    -unity-text-align: upper-right;
}

/* "Release to fit": one line under the dragged part while it is over a bay it fits, on the tube's dark. */
.cargo__release {
    display: none;
    position: absolute;
    font-size: 18px;
    -unity-text-align: middle-center;
    background-color: rgb(19, 18, 16);
    color: rgb(255, 196, 96);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.cargo__release--quiet {
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.cargo__tooltip {
    display: none;
    position: absolute;
}

.cargo__tooltip-name {
    height: 36px;
    font-size: 28px;
    -unity-text-align: middle-left;
    color: rgb(248, 238, 214);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

.cargo__tooltip-desc {
    height: 60px;
    font-size: 22px;
    white-space: normal;
    color: rgb(224, 210, 182);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.cargo__tooltip-use {
    flex-direction: row;
    align-items: center;
    height: 28px;
}

.cargo__tooltip-use-label {
    margin-right: 12px;
    font-size: 18px;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.cargo__tooltip-use-target {
    font-size: 22px;
    color: rgb(224, 210, 182);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.cargo__tooltip-use-target--accent {
    color: rgb(255, 196, 96);
}

.cargo__toast {
    display: none;
    position: absolute;
    justify-content: center;
}

.cargo__toast-text {
    white-space: normal;
    font-size: 18px;
    color: rgb(255, 196, 96);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

/* The one hint row that stands for the locked slots (where the next row grows), and the key hints at the foot. */

.cargo__more {
    position: absolute;
    font-size: 18px;
    -unity-text-align: middle-left;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.cargo__footer {
    position: absolute;
    flex-direction: row;
    align-items: center;
}

.cargo__hint {
    flex-direction: row;
    align-items: center;
    margin-right: 40px;
}

.cargo__key {
    min-width: 36px;
    height: 26px;
    padding: 0 8px;
    border-width: 1.5px;
    border-radius: 5px;
    border-color: rgb(182, 168, 143);
    font-size: 18px;
    color: rgb(224, 210, 182);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.cargo__key-word {
    margin-left: 10px;
    font-size: 18px;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

/* 07's databank page on its CRT (DatabankView), look A like the hold page: categories left, the turning model or a
   print in the middle, the entry's words beside it (name, what it is, why it matters), the key row along the bottom. */

.databank {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* The page tabs: quiet words, the open page lit and underlined in the accent. */
.page-tab {
    position: absolute;
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: rgb(182, 168, 143);
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.page-tab--active {
    color: rgb(248, 238, 214);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

/* The one accent underline under the lit tab; it glides to the other tab while the page changes. */
.page-tab__underline {
    position: absolute;
    background-color: rgb(255, 196, 96);
}

.databank__row {
    position: absolute;
    padding: 0 8px;
    font-size: 18px;
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.databank__row--entry {
    color: rgb(224, 210, 182);
}

.databank__row--focus {
    color: rgb(255, 196, 96);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.databank__dot {
    position: absolute;
    background-color: rgb(224, 210, 182);
}

.databank__model {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.databank__print {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.databank__grain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.databank__empty {
    position: absolute;
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.databank__name {
    position: absolute;
    font-size: 28px;
    -unity-text-align: middle-left;
    color: rgb(248, 238, 214);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/ChakraPetch-SemiBold.asset");
}

.databank__fields {
    position: absolute;
    font-size: 18px;
    white-space: normal;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}

.databank__history {
    position: absolute;
    font-size: 22px;
    white-space: normal;
    color: rgb(224, 210, 182);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.databank__set {
    position: absolute;
    font-size: 18px;
    color: rgb(255, 196, 96);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.databank__readout {
    position: absolute;
    font-size: 18px;
    white-space: normal;
    color: rgb(182, 168, 143);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Regular.asset");
}
/* 07's power-on self-test on its CRT (PostView): a terminal column of typed lines; a part that fails reads amber. */

.post {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 72px 96px;
    justify-content: flex-start;
    overflow: hidden;
}

.post__column {
    flex-shrink: 0;
}

.post__line {
    margin-bottom: 6px;
    font-size: 26px;
    white-space: nowrap;
    color: rgb(255, 224, 152);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

.post__line--alert {
    color: rgb(255, 170, 72);
}

/* 07's face booting before its self-test: the tube's raster, the maker's mark traced by the beam, the load bar */

.boot-face {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* Phosphor amber, brighter along the middle: the raster opens as a warm glow, not a slab */
.boot-face__raster {
    position: absolute;
    min-width: 6px;
    min-height: 4px;
    border-radius: 2px;
    background-color: rgba(255, 174, 56, 0.7);
}

.boot-face__raster-core {
    position: absolute;
    left: 0;
    right: 0;
    top: 35%;
    bottom: 35%;
    background-color: rgba(255, 222, 160, 0.6);
}

.boot-face__logo {
    width: 360px;
    height: 360px;
    --trace-color: rgb(255, 224, 152);
    --trace-halo-scale: 4;
}

.boot-face__wordmark,
.boot-face__load-text {
    font-size: 26px;
    letter-spacing: 2px;
    white-space: nowrap;
    color: rgb(255, 224, 152);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}

/* The mark fills only the middle of its square: the wordmark sits just under the drawn lines */
.boot-face__wordmark {
    margin-top: -72px;
}

.boot-face__load {
    flex-direction: row;
    align-items: center;
}

.boot-face__load-text {
    margin-right: 18px;
}

.boot-face__step {
    width: 18px;
    height: 26px;
    margin-left: 6px;
    border-width: 2px;
    border-color: rgb(255, 224, 152);
}

.boot-face__step--filled {
    background-color: rgb(255, 224, 152);
}

/* The cover over a New Game that reloads: 07's own dark tube closing in from the edges */

.cover-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --cover-color: rgb(18, 12, 6);
}

.face-notice {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.face-notice__line {
    font-size: 30px;
    white-space: nowrap;
    color: rgb(214, 190, 140);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/IBMPlexMono-Medium.asset");
}
