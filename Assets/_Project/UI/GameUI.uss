/*
 * Lofi Lunar UI. Colours come from the palette tokens (--moon-*) that the UI/Theme builder generates from
 * MoonProject.Art.Palette into the theme stylesheet. Indigo glass, cream text, warm amber for what can be done.
 * Type is Be Vietnam Pro (font assets built by the UI/Fonts builder): Regular for text, Medium for things you press,
 * SemiBold for names and headings. Motion is code-driven (Reveal), so nothing here transitions.
 */

.moon-root,
.hud,
.hop-veil,
.hop-veil__dark,
.pause,
.pause__veil,
.pause__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.moon-root {
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/BeVietnamPro-Regular.asset");
}

.title__wordmark,
.pause__heading,
.memory-card__name,
.tower-panel__title,
.caption,
.section-label,
.chip__number,
.friend-name,
.kit-title__name,
.bay-row__name,
.hop-list__glyph,
.dial-readout__station,
.dial-readout__tape,
.glyph__label,
.hold__glyph,
.material-slot__count {
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/BeVietnamPro-SemiBold.asset");
}

.chip__word,
.hold__word,
.pause .menu-button {
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/BeVietnamPro-Medium.asset");
}

Label {
    color: var(--moon-text);
    margin: 0;
    padding: 0;
}

/* Soft shadows (painted, see ShadowPainter): an absolutely positioned layer behind each panel. */

.soft-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --shadow-color: var(--moon-shadow);
    --shadow-offset: 6;
    --shadow-layers: 8;
    --shadow-radius: 22;
    --shadow-spread: 18;
}

.soft-shadow--panel {
    --shadow-radius: 20;
    --shadow-spread: 34;
    --shadow-offset: 12;
}

/* Glass panels and chips */

.panel {
    background-color: var(--moon-glass);
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--moon-glass-edge);
    padding: 22px 26px 20px 26px;
}

.chip {
    flex-direction: row;
    align-items: center;
    padding: 7px 18px 7px 8px;
    border-radius: 24px;
    background-color: var(--moon-glass);
    border-width: 1px;
    border-color: var(--moon-glass-edge);
}

.chip__word {
    font-size: 20px;
    color: var(--moon-text);
}

.chip__number {
    font-size: 20px;
    margin-left: 8px;
    min-width: 24px;
}

.chip--inline {
    background-color: var(--moon-cream-glow);
    border-width: 0;
    padding: 6px 14px 6px 10px;
}

.caption {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--moon-warm-lamp);
}

.caption--quiet {
    color: var(--moon-text-faint);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/BeVietnamPro-Regular.asset");
}

/* Glyphs: a key cap for keys and mouse buttons, a round button for gamepads */

.glyph {
    min-width: 34px;
    height: 34px;
    padding: 0 9px;
    margin-right: 10px;
    border-radius: 9px;
    border-width: 1px;
    border-color: var(--moon-amber-edge);
    background-color: var(--moon-amber-soft);
    justify-content: center;
    align-items: center;
}

.glyph--pad {
    min-width: 34px;
    width: 34px;
    padding: 0;
    border-radius: 17px;
}

.glyph__label {
    font-size: 15px;
    color: var(--moon-warm-lamp);
    -unity-text-align: middle-center;
}

.glyph--small {
    min-width: 26px;
    height: 26px;
    padding: 0 7px;
    margin-right: 8px;
    border-radius: 7px;
}

.glyph--small.glyph--pad {
    min-width: 26px;
    width: 26px;
    padding: 0;
    border-radius: 13px;
}

.glyph--small .glyph__label {
    font-size: 12px;
}

/* Salvage materials (painted, see MaterialIconPainter), in art's bundle colours: steel, copper, violet */

.material-slot {
    flex-direction: row;
    align-items: center;
    margin: 0 6px;
}

.material-icon {
    width: 20px;
    height: 20px;
    --icon-hole-color: var(--moon-sky-top);
}

.material-icon--metal {
    --icon-color: var(--moon-metal);
    --icon-detail: var(--moon-text-faint);
}

.material-icon--wiring {
    --icon-color: var(--moon-warm-accent);
    --icon-detail: var(--moon-warm-lamp);
}

.material-icon--optics {
    --icon-color: var(--moon-sky-horizon);
    --icon-detail: var(--moon-metal);
}

.material-slot__count {
    font-size: 18px;
    margin-left: 6px;
    min-width: 14px;
    color: var(--moon-text);
}

.material-slot__glow {
    position: absolute;
    left: 3px;
    top: 50%;
    width: 16px;
    height: 16px;
    margin-top: -8px;
    --shadow-color: var(--moon-cream);
    --shadow-offset: 0;
    --shadow-layers: 8;
    --shadow-radius: 8;
    --shadow-spread: 16;
}

.materials-chip .material-icon {
    width: 22px;
    height: 22px;
}

.materials-chip .material-slot__count {
    font-size: 19px;
}

/* A recipe: what it takes, the short materials dimmed, and one quiet need line */

.recipe {
    flex-direction: row;
    align-items: center;
}

.recipe .material-icon {
    width: 18px;
    height: 18px;
}

.material-slot--short .material-icon {
    opacity: 0.4;
}

.material-slot--short .material-slot__count {
    color: var(--moon-text-faint);
}

.recipe__need {
    font-size: 15px;
    color: var(--moon-text-faint);
    white-space: normal;
}

/* The cassette icon (painted, see CassetteIconPainter) */

.cassette-icon {
    width: 24px;
    height: 16px;
    --icon-color: var(--moon-warm-lamp);
    --icon-hole-color: var(--moon-sky-top);
}

.relay-icon {
    width: 20px;
    height: 16px;
    --icon-color: var(--moon-warm-lamp);
    --mast-color: var(--moon-text-faint);
}

.relay-icon--tag {
    width: 18px;
    height: 16px;
}

.cassette-icon--quiet {
    width: 20px;
    height: 13px;
    --icon-color: var(--moon-amber-edge);
}

/* Opening title */

.title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8%;
    align-items: center;
}

.title__wordmark {
    font-size: 76px;
    letter-spacing: 16px;
    color: var(--moon-cream);
    -unity-text-align: middle-center;
    text-shadow: 0 4px 22px var(--moon-shadow);
}

.title__rule {
    width: 132px;
    height: 2px;
    margin-top: 16px;
    border-radius: 1px;
    background-color: var(--moon-amber-edge);
}

/*
 * A fitted piece of kit's name (crafted at Kenji's Rover Bay, or a friend's gift): high and quiet, clear of 07, on a
 * soft dusk of shadow so it reads even over the bright Earth.
 */

.kit-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 12%;
    align-items: center;
}

.kit-title__body {
    align-items: center;
    padding: 4px 10px 6px 10px;
}

.soft-shadow--title {
    --shadow-offset: 0;
    --shadow-radius: 30;
    --shadow-spread: 56;
    --shadow-layers: 10;
}

.kit-title__name {
    font-size: 30px;
    letter-spacing: 4px;
    color: var(--moon-cream);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 14px var(--moon-shadow);
}

.kit-title__rule {
    width: 64px;
    height: 2px;
    margin-top: 12px;
    border-radius: 1px;
    background-color: var(--moon-warm-accent);
}

/* Tether reticle (painted, see ReticlePainter) */

.reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    margin-top: -22px;
}

.reticle__ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.reticle__ring--rest {
    --ring-color: var(--moon-text-faint);
    --ring-width: 1.5;
    --glow-color: var(--moon-cream-glow);
    --glow-width: 7;
    --dot-color: var(--moon-text-faint);
    --dot-radius: 1.5;
}

.reticle__ring--hover {
    opacity: 0;
    --ring-color: var(--moon-tech-glow);
    --ring-width: 2;
    --glow-color: var(--moon-glow-soft);
    --glow-width: 9;
    --dot-color: var(--moon-tech-glow);
    --dot-radius: 2;
}

/* Context prompt: anchored to a projected world point, centred above it */

.world-anchor {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

.world-anchor__center {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -100%;
}

/* Friend parts readout: warm pips over a broken friend, no glyphs, no numbers */

.friend-pips {
    padding: 9px 12px;
}

.pip {
    width: 14px;
    height: 14px;
    margin: 0 4px;
    border-width: 1.5px;
    border-radius: 7px;
    border-color: var(--moon-text-faint);
    justify-content: center;
    align-items: center;
}

.pip--full {
    border-color: var(--moon-warm-lamp);
    background-color: var(--moon-amber-soft);
}

.pip__fill {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--moon-warm-lamp);
}

/* A friend's name, the first time it wakes */

.friend-name {
    font-size: 30px;
    letter-spacing: 4px;
    color: var(--moon-cream);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 14px var(--moon-shadow);
}

/* Materials chip: the stock, drifting in only when it changes */

.materials-chip {
    position: absolute;
    top: 44px;
    right: 56px;
}

.materials-chip__body {
    padding: 8px 12px 8px 8px;
}

/* Salvage: the hold ring centred on a piece's cut point, and a site's name over it */

.world-anchor__middle {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
}

.salvage-ring {
    width: 48px;
    height: 48px;
    justify-content: center;
    align-items: center;
    border-radius: 24px;
    background-color: var(--moon-glass);
    --track-color: var(--moon-track);
    --fill-color: var(--moon-warm-lamp);
    --ring-width: 3.5;
}

.salvage-ring__icon {
    width: 20px;
    height: 20px;
}

.site-name {
    font-size: 26px;
    letter-spacing: 3px;
}

/* Radio ticker: one soft line in the bottom band, below every panel and below the prompts' screen margin */

.ticker {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 26px;
    align-items: center;
}

.ticker__line {
    flex-direction: row;
    align-items: center;
    max-width: 72%;
    padding: 7px 20px 7px 16px;
    border-radius: 18px;
    background-color: var(--moon-shadow);
}

.ticker__lamp {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    margin-right: 12px;
    border-radius: 4px;
    background-color: var(--moon-warm-lamp);
}

.ticker__text {
    flex-shrink: 1;
    font-size: 19px;
    letter-spacing: 0.4px;
    color: var(--moon-text-dim);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Dial readout: the station Bell's dial was just turned to, just above the ticker's band */

.dial-readout {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 84px;
    align-items: center;
}

.dial-readout__body {
    min-width: 230px;
    align-items: center;
    padding: 12px 28px 13px 28px;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--moon-glass-edge);
    background-color: var(--moon-glass);
}

.dial-readout__detents {
    flex-direction: row;
    margin-bottom: 9px;
}

.dial-readout__detent {
    width: 9px;
    height: 9px;
    margin: 0 5px;
    border-width: 1.5px;
    border-radius: 5px;
    border-color: var(--moon-text-faint);
}

.dial-readout__detent--lit {
    border-color: var(--moon-warm-lamp);
    background-color: var(--moon-warm-lamp);
}

.dial-readout__station {
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--moon-warm-lamp);
    -unity-text-align: middle-center;
}

.dial-readout__tape {
    margin-top: 5px;
    font-size: 23px;
    color: var(--moon-cream);
    -unity-text-align: middle-center;
}

/* Radio-hop list: the other lit nodes, in the dial readout's place just above the ticker's band */

.hop-list {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 84px;
    align-items: center;
}

.hop-list__rows {
    min-width: 250px;
    padding: 12px 24px 12px 16px;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--moon-glass-edge);
    background-color: var(--moon-glass);
}

.hop-list__row {
    flex-direction: row;
    align-items: center;
    height: 38px;
}

.hop-list__marker {
    width: 30px;
    height: 30px;
    margin-right: 12px;
    justify-content: center;
    align-items: center;
    --track-color: var(--moon-track);
    --fill-color: var(--moon-warm-lamp);
    --ring-width: 2;
}

.hop-list__glyph {
    font-size: 12px;
    color: var(--moon-warm-lamp);
    -unity-text-align: middle-center;
    display: none;
}

.hop-list__name {
    font-size: 19px;
    color: var(--moon-text-dim);
}

.hop-list__row--selected .hop-list__marker {
    border-radius: 15px;
    background-color: var(--moon-amber-soft);
}

.hop-list__row--selected .hop-list__glyph {
    display: flex;
}

.hop-list__row--selected .hop-list__name {
    color: var(--moon-cream);
}

/* Relay price tag: a little mast in the hold ring, the recipe beside it, the need line under them */

.relay-tag__body {
    flex-direction: column;
    align-items: flex-start;
    padding: 6px 16px 6px 7px;
}

.relay-tag__row {
    flex-direction: row;
    align-items: center;
}

.relay-tag__recipe {
    margin-left: 10px;
}

.relay-tag__need {
    font-size: 13px;
    margin: 2px 0 2px 6px;
}

.relay-tag__ring {
    width: 32px;
    height: 32px;
    justify-content: center;
    align-items: center;
    --track-color: var(--moon-track);
    --fill-color: var(--moon-warm-lamp);
    --ring-width: 2.5;
}


/* Radio-hop fade: a soft indigo dark and a faint crawling grain, over the HUD and under the pause menu */

.hop-veil__dark {
    background-color: var(--moon-sky-top);
}

.hop-veil__grain {
    position: absolute;
    -unity-background-image-tint-color: var(--moon-cream);
}

/* Memory card */

.memory-card {
    position: absolute;
    left: 72px;
    bottom: 104px;
    width: 540px;
}

.memory-card__body {
    padding: 24px 30px 20px 30px;
}

.memory-card__heading {
    flex-direction: row;
    align-items: center;
}

.memory-card__caption {
    flex-grow: 1;
    flex-shrink: 1;
}

.memory-card__icon,
.memory-card__count {
    display: none;
}

/* A crew log: its caption says what it is, so it has no name line */

.memory-card--untitled .memory-card__name {
    display: none;
}

.memory-card--untitled .memory-card__text {
    margin-top: 14px;
}

/* Liner notes: a smaller card, warm in its amber frame, honey title and cassette icon, with the tape count */

.memory-card--liner {
    width: 440px;
}

.memory-card--liner .memory-card__body {
    border-color: var(--moon-amber-edge);
}

.memory-card--liner .memory-card__icon {
    display: flex;
    margin-right: 10px;
}

.memory-card--liner .memory-card__count {
    display: flex;
    margin-left: 12px;
}

.memory-card--liner .memory-card__name {
    font-size: 26px;
    color: var(--moon-honey);
}

.memory-card--liner .memory-card__text {
    font-size: 19px;
}

.memory-card__name {
    font-size: 32px;
    margin-top: 10px;
    margin-bottom: 10px;
    white-space: normal;
}

.memory-card__text {
    font-size: 21px;
    color: var(--moon-text-dim);
    white-space: normal;
}

.hint-row {
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
}

.hint-row__word {
    font-size: 15px;
    color: var(--moon-text-faint);
}

/* Tower upgrade panel */

.tower-panel {
    position: absolute;
    right: 72px;
    bottom: 104px;
    width: 430px;
}

.tower-panel__heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.tower-panel__station {
    flex-direction: row;
    align-items: center;
}

.tower-panel__lamp {
    width: 8px;
    height: 8px;
    margin-right: 9px;
    border-radius: 4px;
}

/* Each station's accent: the radio tower's amber lamp, Kenji's Rover Bay in the rover's warm orange paint */

.tower-panel--radio-tower .tower-panel__lamp {
    background-color: var(--moon-warm-lamp);
}

.tower-panel--workshop .tower-panel__lamp {
    background-color: var(--moon-warm-accent);
}

.tower-panel--workshop .tower-panel__name,
.tower-panel--workshop .hold__glyph {
    color: var(--moon-warm-accent);
}

.tower-panel--workshop .hold__ring {
    --fill-color: var(--moon-warm-accent);
}

.tower-panel__title {
    font-size: 27px;
    margin-top: 10px;
    margin-bottom: 6px;
    white-space: normal;
}

.tower-panel__text {
    font-size: 18px;
    color: var(--moon-text-dim);
    white-space: normal;
}

.tower-panel__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 20px;
    min-height: 48px;
}

.tower-panel__need {
    flex-shrink: 1;
    margin-right: 12px;
}

/* Kenji's Rover Bay: what is left to craft, one row each, the picked one lit and read in full */

.tower-panel__choices {
    margin: 12px -12px 0 -12px;
}

.bay-row {
    padding: 9px 12px 10px 12px;
    margin-bottom: 2px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.bay-row--selected {
    background-color: var(--moon-cream-glow);
    border-color: var(--moon-glass-edge);
}

.bay-row__line {
    flex-direction: row;
    align-items: center;
}

.bay-row__lamp {
    width: 6px;
    height: 6px;
    margin-right: 10px;
    border-radius: 3px;
    background-color: var(--moon-track);
}

.bay-row--selected .bay-row__lamp {
    background-color: var(--moon-warm-accent);
}

.bay-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 19px;
    color: var(--moon-text-dim);
}

.bay-row--selected .bay-row__name {
    color: var(--moon-text);
}

.bay-row__recipe {
    flex-shrink: 0;
    margin-left: 12px;
}

.bay-row__effect {
    margin: 3px 0 0 16px;
    font-size: 15px;
    color: var(--moon-text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bay-row--selected .bay-row__effect {
    color: var(--moon-text-dim);
    white-space: normal;
}

.tower-panel__pick {
    margin-top: 0;
    flex-shrink: 0;
}

.hold {
    flex-direction: row;
    align-items: center;
}

.hold__ring {
    width: 48px;
    height: 48px;
    justify-content: center;
    align-items: center;
    --track-color: var(--moon-track);
    --fill-color: var(--moon-warm-lamp);
    --ring-width: 3;
}

.hold__glyph {
    font-size: 15px;
    color: var(--moon-warm-lamp);
    -unity-text-align: middle-center;
}

.hold__word {
    font-size: 18px;
    margin-left: 12px;
}

.tower-panel--celebrate .hold__ring {
    --fill-color: var(--moon-honey);
}

.tower-panel--celebrate .hold__word {
    color: var(--moon-honey);
}

/* While the station works on a purchase nothing can be picked, so the pick hint steps back (its place is kept) */

.tower-panel--celebrate .tower-panel__pick {
    visibility: hidden;
}


/* Pause menu */

.pause__veil {
    background-color: var(--moon-veil);
}

.pause__frame {
    justify-content: center;
    align-items: center;
}

.pause__stack {
    width: 410px;
}

.pause__settings {
    position: absolute;
    left: 100%;
    top: 0;
    width: 480px;
    margin-left: 26px;
}

.pause__panel {
    padding: 28px 28px 22px 28px;
}

.pause__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
    padding-left: 8px;
}

.pause__heading {
    font-size: 36px;
}

.pause__subheading {
    font-size: 16px;
    color: var(--moon-text-faint);
    margin-top: 4px;
}

.pause__cassettes {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.pause__cassettes-count {
    margin-left: 9px;
    font-size: 15px;
    color: var(--moon-text-dim);
}

.pause__relays {
    margin-top: 6px;
}

.pause__pages {
    min-height: 196px;
}

.pause__question {
    font-size: 23px;
    margin-top: 6px;
    padding-left: 8px;
}

.pause__aside {
    font-size: 16px;
    color: var(--moon-text-dim);
    margin-top: 4px;
    margin-bottom: 14px;
    padding-left: 8px;
    white-space: normal;
}

.pause .menu-button {
    height: 54px;
    margin: 4px 0;
    padding: 0 18px;
    border-radius: 15px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--moon-text);
    font-size: 22px;
    -unity-text-align: middle-left;
}

.pause .menu-button--quiet {
    color: var(--moon-text-dim);
}

.pause .menu-button--compact {
    flex-grow: 1;
    height: 38px;
    margin: 0 8px;
    padding: 0 14px;
    font-size: 18px;
    border-radius: 12px;
    border-color: var(--moon-glass-edge);
    background-color: var(--moon-cream-glow);
    -unity-text-align: middle-center;
}

.pause__panel--settings .menu-button--quiet {
    margin-top: 12px;
    padding-left: 4px;
}

.pause .menu-button:hover {
    background-color: var(--moon-cream-glow);
}

.pause .menu-button:focus {
    background-color: var(--moon-amber-soft);
    border-color: var(--moon-amber-edge);
    color: var(--moon-warm-lamp);
}

.pause .menu-button:active {
    background-color: var(--moon-amber-edge);
    color: var(--moon-cream);
}

.section-label {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--moon-warm-lamp);
    margin-top: 16px;
    margin-bottom: 4px;
    padding-left: 4px;
}

.section-label--first {
    margin-top: 0;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    height: 46px;
    padding-left: 4px;
}

.setting-row__label {
    width: 130px;
    font-size: 18px;
    color: var(--moon-text-dim);
}

.setting-row__slider {
    flex-grow: 1;
    margin: 0 8px;
}

.setting-row__value {
    width: 52px;
    font-size: 16px;
    color: var(--moon-text-faint);
    -unity-text-align: middle-right;
}

.pause .unity-base-slider__tracker {
    height: 6px;
    margin-top: -3px;
    border-width: 0;
    border-radius: 3px;
    background-color: var(--moon-track);
}

.pause .unity-base-slider__fill {
    border-radius: 3px;
    background-color: var(--moon-amber-edge);
}

.pause .unity-base-slider__dragger {
    width: 20px;
    height: 20px;
    margin-top: -10px;
    border-width: 0;
    border-radius: 10px;
    background-color: var(--moon-cream);
}

.pause .unity-base-slider__dragger-border {
    display: none;
}

.pause .unity-base-slider:focus .unity-base-slider__dragger {
    background-color: var(--moon-warm-lamp);
}

.pause .unity-base-slider:focus .unity-base-slider__fill {
    background-color: var(--moon-warm-lamp);
}

.pause .unity-toggle__checkmark {
    width: 24px;
    height: 24px;
    border-width: 1px;
    border-radius: 7px;
    border-color: var(--moon-glass-edge);
    background-color: var(--moon-track);
}

.pause .unity-toggle:focus .unity-toggle__checkmark {
    border-color: var(--moon-amber-edge);
}

.pause .unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--moon-warm-lamp);
}
