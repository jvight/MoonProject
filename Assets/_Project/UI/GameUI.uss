/*
 * Lunarion UI. Colours come from the palette tokens (--moon-*) that the UI/Theme builder generates from
 * MoonProject.Art.Palette into the theme stylesheet. Indigo glass, cream text, warm amber for what can be done.
 * Type is Be Vietnam Pro (font assets built by the UI/Fonts builder): Regular for text, Medium for things you press,
 * SemiBold for names and headings. Motion is code-driven (Reveal), so nothing here transitions.
 */

.moon-root,
.hud,
.lab-hud,
.hop-veil,
.hop-veil__dark,
.pause,
.pause__veil,
.pause__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* A safe frame fills the screen until SafeFrame insets it (an ultra-wide screen, a device's unsafe edges) */
.safe-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.moon-root {
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/NunitoSans-Regular.asset");
}

.pause__heading,
.memory-card__name,
.tower-panel__title,
.chip__number,
.name-tag__name,
.bay-row__name,
.hop-list__glyph,
.dial-readout__station,
.dial-readout__tape,
.glyph__label,
.hold__glyph,
.material-slot__count {
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-SemiBold.asset");
    font-size: 22px;
}

.chip__word,
.hold__word,
.caption,
.section-label,
.next-line__text,
.ticker__text,
.place-card__job,
.memory-card__text,
.tower-panel__text,
.recipe__need,
.material-slot__word,
.hint-row__word,
.bay-row__effect,
.recovery-board__node,
.recovery-board__target,
.verb-row__word,
.pause .menu-button {
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/NunitoSans-SemiBold.asset");
}

Label {
    color: var(--moon-text);
    margin: 0;
    padding: 0;
}

/* Soft shadows (painted, see ShadowPainter): an absolutely positioned layer behind each panel. */

.soft-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --shadow-color: var(--moon-shadow);
    --shadow-offset: 6;
    --shadow-layers: 8;
    --shadow-radius: 22;
    --shadow-spread: 18;
}

/* Glass panels carry their own soft rim glow (UI/Glass), so their shadow layer stays empty */
.soft-shadow--panel {
    display: none;
}

/* Glass panels and chips */

/* Moonlight Glass: the blue glass gradient, rim and glows are one 9-sliced texture drawn at 2x */
.panel {
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPanel.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.5;
    padding: 22px 26px 20px 26px;
}

.chip {
    flex-direction: row;
    align-items: center;
    padding: 7px 18px 7px 8px;
    border-radius: 24px;
    background-color: var(--moon-glass);
    border-width: 1px;
    border-color: var(--moon-glass-edge);
}

.chip__word {
    font-size: 26px;
    color: var(--moon-text);
}

/* The prompt (Moonlight Glass): the key's round bubble, then the action on its own glass pill */
.prompt .chip {
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.prompt .chip__word {
    padding: 4px 20px 6px 20px;
    border-radius: 22px;
    border-width: 1px;
    border-color: var(--glass-rim);
    background-color: var(--moon-glass);
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/NunitoSans-Bold.asset");
}

.chip__number {
    font-size: 22px;
    margin-left: 8px;
    min-width: 24px;
}

.caption {
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--moon-warm-lamp);
}

.caption--quiet {
    color: var(--moon-text-faint);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/NunitoSans-Regular.asset");
}

/* Glyphs: a key cap for keys and mouse buttons, a round button for gamepads */

/* A key or button: a round glass bubble with a bright rim and the key in white Exo 2 (Moonlight Glass) */
.glyph {
    min-width: 44px;
    height: 44px;
    padding: 0 12px;
    margin-right: 10px;
    border-radius: 22px;
    border-width: 2px;
    border-color: var(--glass-rim);
    background-color: var(--glass-bubble);
    justify-content: center;
    align-items: center;
}

.glyph--pad {
    min-width: 44px;
    width: 44px;
    padding: 0;
    border-radius: 22px;
}

.glyph__label {
    font-size: 20px;
    color: var(--glass-hi);
    -unity-text-align: middle-center;
}

.glyph--small {
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    margin-right: 8px;
    border-radius: 8px;
}

.glyph--small.glyph--pad {
    min-width: 30px;
    width: 30px;
    padding: 0;
    border-radius: 15px;
}

.glyph--small .glyph__label {
    font-size: 18px;
}

/* Salvage materials (painted, see MaterialIconPainter), in art's bundle colours: steel, copper, violet */

.material-slot {
    flex-direction: row;
    align-items: center;
    margin: 0 6px;
}

.material-icon {
    width: 24px;
    height: 24px;
    --icon-hole-color: var(--moon-sky-top);
}

.material-icon--metal {
    --icon-color: var(--moon-metal);
    --icon-detail: var(--moon-text-faint);
}

.material-icon--wiring {
    --icon-color: var(--moon-warm-accent);
    --icon-detail: var(--moon-warm-lamp);
}

.material-icon--circuit_chips {
    --icon-color: rgb(63, 174, 122);
    --icon-detail: rgb(191, 238, 218);
}

.material-icon--orange_beads {
    --icon-color: rgb(255, 154, 60);
    --icon-detail: rgb(255, 217, 168);
}

.material-icon--ilmenite {
    --icon-color: rgb(110, 120, 146);
    --icon-detail: rgb(190, 198, 218);
}

.material-icon--water_ice {
    --icon-color: rgb(159, 217, 255);
    --icon-detail: rgb(255, 255, 255);
}

.material-icon--rare_earths {
    --icon-color: rgb(200, 139, 255);
    --icon-detail: rgb(239, 217, 255);
}

.material-icon--glass {
    --icon-color: rgb(255, 207, 122);
    --icon-detail: rgb(255, 241, 207);
}

.material-icon--alloy {
    --icon-color: rgb(140, 168, 212);
    --icon-detail: rgb(222, 234, 255);
}

.material-icon--coolant {
    --icon-color: rgb(94, 230, 214);
    --icon-detail: rgb(214, 255, 249);
}

.material-icon--crystal {
    --icon-color: rgb(255, 127, 192);
    --icon-detail: rgb(255, 214, 236);
}

.material-icon--superconductor {
    --icon-color: rgb(255, 228, 94);
    --icon-detail: rgb(255, 246, 184);
}

.material-icon--optics {
    --icon-color: var(--moon-sky-horizon);
    --icon-detail: var(--moon-metal);
}

.material-slot__count {
    font-size: 18px;
    margin-left: 6px;
    min-width: 14px;
    color: var(--moon-text);
}

/* A recipe, one row per material (docs/design/first-hour-v2 6.5): icon, name, the need and what 07 has, a check once
   it is covered; a short one reads dim. One quiet need line under them. */

.recipe {
    flex-direction: column;
    align-items: flex-start;
}

.recipe .material-icon {
    width: 24px;
    height: 24px;
}

.recipe .material-slot {
    margin: 3px 0;
}

.material-slot__word {
    min-width: 92px;
    margin-left: 10px;
    font-size: 22px;
    color: var(--moon-text);
}

.recipe .material-slot__count {
    margin-left: 6px;
    font-size: 22px;
    white-space: nowrap;
}

/* A covered material wears a painted check (the fonts have none); a short one reads dim, with no check */
.material-slot__check {
    width: 18px;
    height: 18px;
    margin-left: 8px;
    --check-color: var(--moon-warm-lamp);
}

.material-slot--short .material-slot__check {
    display: none;
}

.material-slot--short .material-icon {
    opacity: 0.7;
}

.material-slot--short .material-slot__count,
.material-slot--short .material-slot__word {
    color: var(--moon-text-dim);
}

/* A bay row's cost stays on its line: icon and have / need, no names */

.bay-row__recipe {
    flex-direction: row;
    align-items: center;
}

.bay-row__recipe .material-slot {
    margin: 0 6px;
}

.bay-row__recipe .material-slot__count {
    min-width: 0;
}

.recipe__need {
    font-size: 18px;
    color: var(--moon-text-faint);
    white-space: normal;
}

/* The cassette icon (painted, see CassetteIconPainter) */

.cassette-icon {
    width: 24px;
    height: 16px;
    --icon-color: var(--moon-warm-lamp);
    --icon-hole-color: var(--moon-sky-top);
}

.relay-icon {
    width: 20px;
    height: 16px;
    --icon-color: var(--moon-warm-lamp);
    --mast-color: var(--moon-text-faint);
}

.relay-icon--tag {
    width: 18px;
    height: 16px;
}

.cassette-icon--quiet {
    width: 20px;
    height: 13px;
    --icon-color: var(--moon-amber-edge);
}

/* The title over the live world (M3-09): the wordmark in the sky, a quiet subtitle, the menu low and left */

/* The open sky right of Earth and The Peak's beacon in the title frame, never over 07 */
.title-screen {
    position: absolute;
    left: 66%;
    right: 4%;
    top: 3%;
    align-items: center;
}

/* Drawn by WordmarkPainter from the approved SVG; its height follows its width */
.title-screen__wordmark {
    width: 100%;
    --ink-color: var(--moon-cream);
    --glow-color: var(--moon-amber-soft);
    --glow-width: 18px;
}

.title-screen__subtitle {
    margin-top: 10px;
    font-size: 19px;
    letter-spacing: 4px;
    color: var(--moon-text-dim);
    -unity-text-align: middle-center;
}

.pause--title .pause__veil,
.pause--title .pause__header {
    display: none;
}

.pause--title .pause__frame {
    justify-content: flex-end;
    align-items: flex-start;
    padding-left: 7%;
    padding-bottom: 48px;
}

/* The settings panel is tall: while it is open the title's menu steps down to a small margin so it fits at any text size */
.pause--title.pause--settings-open .pause__frame {
    padding-bottom: 8px;
}

.pause--title .pause__stack {
    width: 340px;
}

/* The title's menu sits low, so its settings open beside it and grow upward from its foot, never off the bottom */
.pause--title .pause__settings {
    top: auto;
    bottom: 0;
}

.pause--title .pause__question,
.pause--title .pause__aside {
    white-space: normal;
}

/* The save tick: a tiny cream "07" and check mark in the bottom corner, only for a moment after a real save */
.save-tick {
    position: absolute;
    right: 34px;
    bottom: 30px;
    flex-direction: row;
    align-items: center;
}

.save-tick__word {
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--moon-text);
    text-shadow: 0 2px 10px var(--moon-shadow);
}

.save-tick__check {
    width: 20px;
    height: 20px;
    margin-left: 8px;
    --tick-color: var(--moon-cream);
}

/* The credits: a centred glass panel over the title, its text drifting up slowly */
.credits {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.credits__panel {
    width: 46%;
    min-width: 520px;
    height: 76%;
    padding: 24px 32px 20px 32px;
}

.credits__title {
    margin-bottom: 14px;
    font-size: 30px;
    letter-spacing: 4px;
    color: var(--glass-hi);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-SemiBold.asset");
}

.credits__scroll {
    flex-grow: 1;
    margin-bottom: 12px;
}

.credits__heading {
    margin-top: 30px;
    margin-bottom: 8px;
    font-size: 24px;
    letter-spacing: 3px;
    color: var(--glass-sel);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-Bold.asset");
}

.credits__version {
    margin-bottom: 14px;
    font-size: 18px;
    color: var(--moon-text-dim);
    -unity-text-align: middle-center;
}

.credits__name {
    margin-top: 10px;
    font-size: 22px;
    color: var(--glass-hi);
    white-space: normal;
    -unity-text-align: middle-center;
}

.credits__detail {
    font-size: 18px;
    color: var(--glass-ring);
    white-space: normal;
    -unity-text-align: middle-center;
}

.credits__note {
    font-size: 18px;
    color: var(--moon-text-dim);
    white-space: normal;
    -unity-text-align: middle-center;
}

.curtain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--moon-sky-top);
}

/*
 * Floating names (a fitted piece of kit, a friend waking, a site answering the sonar): cream type on a soft dusk of
 * shadow and no plate, so each reads even over the bright Earth or a lit sky. One look for every name.
 */

.name-tag {
    align-items: center;
    padding: 4px 10px 6px 10px;
}

.soft-shadow--name {
    --shadow-offset: 0;
    --shadow-radius: 30;
    --shadow-spread: 56;
    --shadow-layers: 10;
}

.name-tag__name {
    font-size: 34px;
    letter-spacing: 2px;
    color: var(--moon-cream);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 14px var(--moon-shadow);
}

/* The soft "next" line: the current step's invitation, high and quiet, only while 07 is still */

.next-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 124px;
    align-items: center;
}

/* The distance home at the top centre, over the next line (Moonlight Glass, Subnautica's depth gauge) */
.home-meter {
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    align-items: center;
}

.home-meter__arc {
    width: 250px;
    height: 60px;
    --track-color: var(--moon-track);
    --fill-color: var(--glass-sel);
    --tick-color: var(--glass-rim);
    --ring-width: 3;
}

.home-meter__row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: -30px;
}

.home-meter__value {
    font-size: 46px;
    color: var(--glass-hi);
    text-shadow: 0 0 14px var(--glass-rim-glow);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-SemiBold.asset");
}

.home-meter__unit {
    margin-left: 3px;
    margin-bottom: 8px;
    font-size: 22px;
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-SemiBold.asset");
}

.home-meter__key {
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--moon-text-dim);
}

.next-line__text {
    font-size: 26px;
    letter-spacing: 1px;
    color: var(--moon-text);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 12px var(--moon-shadow);
}

/* 07's cells (docs/design/first-hour-v2 6.4): a small row of pills on a glass plate, top left, one pill per cell */

/* The battery dial at the bottom left (Moonlight Glass, like Subnautica's vitals) */
.battery-dial {
    position: absolute;
    left: 100px;
    bottom: 69px;
    width: 142px;
    height: 142px;
}

.battery-dial__face {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassDial.png");
}

.battery-dial__ring {
    position: absolute;
    left: 13px;
    top: 13px;
    right: 13px;
    bottom: 13px;
    --track-color: var(--moon-track);
    --fill-color: var(--glass-ring);
    --low-color: var(--glass-sel);
    --ring-width: 9;
}

.battery-dial__value {
    font-size: 38px;
    color: var(--glass-hi);
    -unity-text-align: middle-center;
}

.battery-dial__word {
    margin-top: -4px;
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--moon-text-dim);
    -unity-text-align: middle-center;
}

/* Every line sits on a glass plate (docs/design/first-hour-v2 6.2): the next line, the ticker, a place's card */

/* Moonlight Glass: each plate is the glass pill (UI/Glass, 2x) */
.next-line .name-tag,
.place-card .name-tag {
    padding: 12px 30px 14px 30px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPill.png");
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 72;
    -unity-slice-bottom: 72;
    -unity-slice-scale: 0.5;
}

/* A place's card, the first time 07 comes near: its name and its one job, below where kit titles rest */

.place-card {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    align-items: center;
}

/* A place's name is white Exo 2 over a short amber underline, as in the mockup */
.place-card .name-tag__name {
    color: var(--glass-hi);
}

/* A short amber underline beneath a place's name, as in the mockup */
.place-card__rule {
    width: 96px;
    height: 4px;
    margin-top: 6px;
    border-radius: 2px;
    background-color: var(--glass-sel);
}

.place-card__job {
    margin-top: 8px;
    font-size: 26px;
    color: var(--moon-text);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 12px var(--moon-shadow);
}

/* A fitted piece of kit's name (crafted at Kenji's Rover Bay, or a friend's gift): high and quiet, clear of 07 */

.kit-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    align-items: center;
}

/* The tower's reward card (feel-pass 8.2): glass in the upper third, a title and a few short lines of what it gave */

.reward-anchor {
    position: absolute;
    left: 0;
    right: 0;
    top: 20%;
    align-items: center;
}

.reward-card {
    min-width: 440px;
    max-width: 640px;
    padding: 20px 34px 22px 34px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPanel.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.5;
}

.reward-card__title {
    margin-bottom: 12px;
    font-size: 28px;
    letter-spacing: 3px;
    color: var(--glass-hi);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-SemiBold.asset");
}

.reward-card__lines {
    align-items: flex-start;
}

.reward-card__row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
}

.reward-card__lamp {
    width: 8px;
    height: 8px;
    margin-right: 14px;
    border-radius: 4px;
    background-color: var(--moon-warm-accent);
}

.reward-card__line {
    font-size: 22px;
    color: var(--glass-hi);
    white-space: normal;
}

/* The unlock card: a kit has just been fitted; its key, its word and one line of what it lets 07 do */

.unlock-anchor {
    position: absolute;
    left: 0;
    right: 0;
    top: 20%;
    align-items: center;
}

.unlock-card {
    flex-direction: row;
    align-items: center;
    min-width: 440px;
    max-width: 700px;
    padding: 18px 32px 18px 26px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPanel.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.5;
}

.unlock-card__text {
    margin-left: 22px;
    flex-shrink: 1;
}

.unlock-card__verb {
    font-size: 28px;
    letter-spacing: 2px;
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-SemiBold.asset");
}

.unlock-card__line {
    margin-top: 4px;
    font-size: 21px;
    white-space: normal;
    color: var(--glass-hi);
}

.kit-title__rule {
    width: 64px;
    height: 2px;
    margin-top: 12px;
    border-radius: 1px;
    background-color: var(--moon-warm-accent);
}

/* Tether reticle (painted, see ReticlePainter) */

.reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    margin-top: -22px;
}

.reticle__ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.reticle__ring--rest {
    --ring-color: var(--moon-text-faint);
    --ring-width: 1.5;
    --glow-color: var(--moon-cream-glow);
    --glow-width: 7;
    --dot-color: var(--moon-text-faint);
    --dot-radius: 1.5;
}

.reticle__ring--hover {
    opacity: 0;
    --ring-color: var(--moon-tech-glow);
    --ring-width: 2;
    --glow-color: var(--moon-glow-soft);
    --glow-width: 9;
    --dot-color: var(--moon-tech-glow);
    --dot-radius: 2;
}

/* Context prompt: anchored to a projected world point, centred above it */

.world-anchor {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

.world-anchor__center {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -100%;
}

/* Friend parts readout: warm pips over a broken friend, no glyphs, no numbers */

.friend-chip {
    flex-direction: row;
    align-items: center;
    padding: 9px 16px 9px 16px;
}

.friend-chip__label {
    margin-right: 12px;
    font-size: 20px;
    color: var(--glass-hi);
}

.friend-pips {
    flex-direction: row;
    align-items: center;
}

.pip {
    width: 14px;
    height: 14px;
    margin: 0 4px;
    border-width: 1.5px;
    border-radius: 7px;
    border-color: var(--moon-text-faint);
    justify-content: center;
    align-items: center;
}

.pip--full {
    border-color: var(--moon-warm-lamp);
    background-color: var(--moon-amber-soft);
}

.pip__fill {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--moon-warm-lamp);
}

/*
 * The pickup feed (Subnautica's pickup notices): small glass rows at the left, one per material that just grew, each
 * with its icon, name, a "+N" and the new total. A row slides in from the left (PickupFeedSettings.SlideDistance).
 */

.pickup-feed {
    position: absolute;
    left: 0;
    top: 36%;
    align-items: flex-start;
}

.pickup-row {
    margin-bottom: 8px;
}

.pickup-row__body {
    flex-direction: row;
    align-items: center;
    min-width: 280px;
    padding: 9px 22px 9px 18px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPill.png");
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 72;
    -unity-slice-bottom: 72;
    -unity-slice-scale: 0.5;
}

.pickup-row .material-icon {
    width: 26px;
    height: 26px;
    margin-right: 12px;
}

.pickup-row__name {
    flex-grow: 1;
    margin-right: 16px;
    font-size: 20px;
    color: var(--glass-hi);
}

.pickup-row__plus,
.pickup-row__gain {
    font-size: 24px;
    color: var(--glass-sel);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-Bold.asset");
}

.pickup-row__gain {
    min-width: 34px;
    margin-right: 18px;
}

.pickup-row__total {
    min-width: 36px;
    font-size: 22px;
    color: var(--moon-text-dim);
    -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-SemiBold.asset");
}

/* Salvage: the hold ring centred on a piece's cut point, and a site's name over it */

.world-anchor__middle {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
}

.salvage-ring {
    width: 48px;
    height: 48px;
    justify-content: center;
    align-items: center;
    border-radius: 24px;
    background-color: var(--moon-glass);
    --track-color: var(--moon-track);
    --fill-color: var(--moon-warm-lamp);
    --charge-color: var(--moon-cream);
    --ring-width: 3.5;
}

.salvage-ring__icon {
    width: 20px;
    height: 20px;
}

.site-name {
    font-size: 26px;
    letter-spacing: 2px;
}

/* The one-time Look up hint: the prompt chip's look, low and centred, above the ticker's band */

.look-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

/* Radio ticker: a glass toast on the right with a round icon bubble, like Subnautica's hints (Moonlight Glass) */

.ticker {
    position: absolute;
    right: 2.5%;
    top: 38%;
    align-items: flex-end;
}

.ticker__line {
    flex-direction: row;
    align-items: center;
    max-width: 460px;
    padding: 14px 26px 14px 16px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPill.png");
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 72;
    -unity-slice-bottom: 72;
    -unity-slice-scale: 0.5;
}

.ticker__lamp {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    margin-right: 14px;
    justify-content: center;
    align-items: center;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassBubble.png");
}

.ticker__icon {
    width: 24px;
    height: 24px;
    --icon-color: var(--glass-hi);
    --mast-color: var(--glass-rim);
}

.ticker__text {
    flex-shrink: 1;
    font-size: 24px;
    letter-spacing: 0.2px;
    color: var(--moon-text);
    white-space: normal;
    -unity-text-align: middle-left;
}

/* Dial readout: the station Bell's dial was just turned to, just above the ticker's band */

.dial-readout {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

.dial-readout__body {
    min-width: 230px;
    align-items: center;
    padding: 12px 28px 13px 28px;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--moon-glass-edge);
    background-color: var(--moon-glass);
}

.dial-readout__detents {
    flex-direction: row;
    margin-bottom: 9px;
}

.dial-readout__detent {
    width: 9px;
    height: 9px;
    margin: 0 5px;
    border-width: 1.5px;
    border-radius: 5px;
    border-color: var(--moon-text-faint);
}

.dial-readout__detent--lit {
    border-color: var(--moon-warm-lamp);
    background-color: var(--moon-warm-lamp);
}

.dial-readout__station {
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--moon-warm-lamp);
    -unity-text-align: middle-center;
}

.dial-readout__tape {
    margin-top: 5px;
    font-size: 22px;
    color: var(--moon-cream);
    -unity-text-align: middle-center;
}

/* Radio-hop list: the other lit nodes, in the dial readout's place just above the ticker's band */

.hop-list {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

.hop-list__rows {
    min-width: 250px;
    padding: 12px 24px 12px 16px;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--moon-glass-edge);
    background-color: var(--moon-glass);
}

.hop-list__row {
    flex-direction: row;
    align-items: center;
    height: 38px;
}

.hop-list__marker {
    width: 30px;
    height: 30px;
    margin-right: 12px;
    justify-content: center;
    align-items: center;
    --track-color: var(--moon-track);
    --fill-color: var(--moon-warm-lamp);
    --ring-width: 2;
}

.hop-list__glyph {
    font-size: 18px;
    color: var(--moon-warm-lamp);
    -unity-text-align: middle-center;
    display: none;
}

.hop-list__name {
    font-size: 22px;
    color: var(--moon-text-dim);
}

.hop-list__row--selected .hop-list__marker {
    border-radius: 15px;
    background-color: var(--moon-amber-soft);
}

.hop-list__row--selected .hop-list__glyph {
    display: flex;
}

.hop-list__row--selected .hop-list__name {
    color: var(--moon-cream);
}

/* Relay price tag: a little mast in the hold ring, the recipe beside it, the need line under them */

.relay-tag__body {
    flex-direction: column;
    align-items: flex-start;
    padding: 6px 16px 6px 7px;
}

.relay-tag__row {
    flex-direction: row;
    align-items: center;
}

.relay-tag__recipe {
    margin-left: 10px;
}

.relay-tag__need {
    font-size: 18px;
    margin: 2px 0 2px 6px;
}

.relay-tag__ring {
    width: 32px;
    height: 32px;
    justify-content: center;
    align-items: center;
    --track-color: var(--moon-track);
    --fill-color: var(--moon-warm-lamp);
    --ring-width: 2.5;
}


/* Radio-hop fade: a soft indigo dark and a faint crawling grain, over the HUD and under the pause menu */

.hop-veil__dark {
    background-color: var(--moon-sky-top);
}

.hop-veil__grain {
    position: absolute;
    -unity-background-image-tint-color: var(--moon-cream);
}

/* Memory card */

.memory-card {
    position: absolute;
    left: 0;
    bottom: 24px;
    width: 520px;
}

.memory-card__body {
    padding: 24px 30px 20px 30px;
}

.memory-card__heading {
    flex-direction: row;
    align-items: center;
}

.memory-card__caption {
    flex-grow: 1;
    flex-shrink: 1;
}

.memory-card__icon,
.memory-card__count {
    display: none;
}

/* A crew log: its caption says what it is, so it has no name line */

.memory-card--untitled .memory-card__name {
    display: none;
}

.memory-card--untitled .memory-card__text {
    margin-top: 14px;
}

/* Liner notes: a smaller card, warm in its amber frame, honey title and cassette icon, with the tape count */

.memory-card--liner {
    width: 440px;
}

.memory-card--liner .memory-card__body {
    border-color: var(--moon-amber-edge);
}

.memory-card--liner .memory-card__icon {
    display: flex;
    margin-right: 10px;
}

.memory-card--liner .memory-card__count {
    display: flex;
    margin-left: 12px;
}

.memory-card--liner .memory-card__name {
    font-size: 28px;
    color: var(--moon-honey);
}

.memory-card--liner .memory-card__text {
    font-size: 22px;
}

.memory-card__name {
    font-size: 28px;
    margin-top: 10px;
    margin-bottom: 10px;
    white-space: normal;
}

.memory-card__text {
    font-size: 22px;
    color: var(--moon-text-dim);
    white-space: normal;
}

.hint-row {
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
}

.hint-row__word {
    font-size: 18px;
    color: var(--moon-text-faint);
}

/* Tower upgrade panel */

.tower-panel {
    position: absolute;
    right: 0;
    bottom: 24px;
    width: 520px;
}

.tower-panel__heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.tower-panel__station {
    flex-direction: row;
    align-items: center;
}

.tower-panel__state {
    margin-left: 12px;
    letter-spacing: 2px;
    color: var(--moon-warm-lamp);
}

.tower-panel__lamp {
    width: 8px;
    height: 8px;
    margin-right: 9px;
    border-radius: 4px;
}

/* Each station's accent: the radio tower's amber lamp, Kenji's Rover Bay in the rover's warm orange paint */

.tower-panel--radio-tower .tower-panel__lamp {
    background-color: var(--moon-warm-lamp);
}

.tower-panel--workshop .tower-panel__lamp {
    background-color: var(--moon-warm-accent);
}

.tower-panel--workshop .tower-panel__name,
.tower-panel--workshop .hold__glyph {
    color: var(--moon-warm-accent);
}

.tower-panel--workshop .hold__ring {
    --fill-color: var(--moon-warm-accent);
}

.tower-panel__title {
    font-size: 28px;
    margin-top: 10px;
    margin-bottom: 6px;
    white-space: normal;
}

.tower-panel__text {
    font-size: 22px;
    color: var(--moon-text-dim);
    white-space: normal;
}

.tower-panel__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 20px;
    min-height: 48px;
}

.tower-panel__need {
    flex-shrink: 1;
    margin-right: 12px;
}

/* Kenji's Rover Bay: what is left to craft, one row each, the picked one lit and read in full */

.tower-panel__choices {
    margin: 12px -12px 0 -12px;
}

.bay-row {
    padding: 9px 12px 10px 12px;
    margin-bottom: 2px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.bay-row--selected {
    background-color: var(--glass-bar);
    border-color: var(--glass-rim);
}

.bay-row__line {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.bay-row__lamp {
    width: 6px;
    height: 6px;
    margin-right: 10px;
    border-radius: 3px;
    background-color: var(--moon-track);
}

.bay-row--selected .bay-row__lamp {
    background-color: var(--moon-warm-accent);
}

.bay-row__name {
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 170px;
    font-size: 22px;
    color: var(--moon-text-dim);
}

.bay-row--selected .bay-row__name {
    color: var(--moon-text);
}

.bay-row__recipe {
    flex-shrink: 0;
    margin-left: 12px;
}

.bay-row__effect {
    margin: 3px 0 0 16px;
    font-size: 18px;
    color: var(--moon-text-faint);
    display: none;
}

.bay-row--selected .bay-row__effect {
    color: var(--moon-text-dim);
    white-space: normal;
    display: flex;
}

.tower-panel__pick {
    margin-top: 0;
    flex-shrink: 0;
}

.hold {
    flex-direction: row;
    align-items: center;
}

.hold__ring {
    width: 48px;
    height: 48px;
    justify-content: center;
    align-items: center;
    --track-color: var(--moon-track);
    --fill-color: var(--moon-warm-lamp);
    --ring-width: 3;
}

.hold__glyph {
    font-size: 18px;
    color: var(--moon-warm-lamp);
    -unity-text-align: middle-center;
}

.hold__word {
    font-size: 22px;
    margin-left: 12px;
}

.tower-panel--celebrate .hold__ring {
    --fill-color: var(--moon-honey);
}

.tower-panel--celebrate .hold__word {
    color: var(--moon-honey);
}

/* While the station works on a purchase nothing can be picked, so the pick hint steps back (its place is kept) */

.tower-panel--celebrate .tower-panel__pick {
    visibility: hidden;
}


/* Pause menu */

.pause__veil {
    background-color: var(--moon-veil);
}

.pause__frame {
    justify-content: center;
    align-items: center;
}

.pause__stack {
    width: 410px;
}

.pause__settings {
    position: absolute;
    left: 100%;
    top: 0;
    width: 480px;
    margin-left: 26px;
}

.pause__panel {
    padding: 28px 28px 22px 28px;
}

/* The menu's title bar: a band of brighter glass across the panel's top, the heading in Exo 2 capitals */
.pause__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin: -16px -20px 18px -20px;
    padding: 12px 28px 12px 28px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    background-color: var(--glass-bar);
}

.pause__heading {
    font-size: 30px;
    letter-spacing: 4px;
    color: var(--glass-hi);
}

.pause__subheading {
    font-size: 18px;
    color: var(--moon-text-faint);
    margin-top: 4px;
}

.pause__cassettes {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.pause__cassettes-count {
    margin-left: 9px;
    font-size: 18px;
    color: var(--moon-text-dim);
}

.pause__relays {
    margin-top: 6px;
}

.pause__pages {
    min-height: 196px;
}

/* "07 can": the verbs learned so far, a reference and never a tutorial (docs/design/first-hour-v2 6.5) */

.pause__can {
    margin-top: 12px;
    padding-left: 8px;
}

.pause--title .pause__can {
    display: none;
}

.pause__can-rows {
    flex-direction: row;
    flex-wrap: wrap;
}

.verb-row {
    flex-direction: row;
    align-items: center;
    margin: 0 20px 8px 0;
}

.verb-row__word {
    font-size: 18px;
    color: var(--moon-text);
}

.pause__question {
    font-size: 23px;
    margin-top: 6px;
    padding-left: 8px;
}

.pause__aside {
    font-size: 18px;
    color: var(--moon-text-dim);
    margin-top: 4px;
    margin-bottom: 14px;
    padding-left: 8px;
    white-space: normal;
}

.pause .menu-button {
    height: 50px;
    margin: 5px 0;
    padding: 0 18px;
    border-radius: 13px;
    border-width: 1px;
    border-color: var(--glass-rim);
    background-color: var(--glass-btn);
    color: var(--glass-hi);
    font-size: 22px;
    -unity-text-align: middle-center;
}

.pause .menu-button--quiet {
    color: var(--moon-text);
    background-color: var(--moon-glass);
}

.pause .menu-button--compact {
    flex-grow: 1;
    height: 38px;
    margin: 0 8px;
    padding: 0 14px;
    font-size: 18px;
    border-radius: 12px;
    border-color: var(--glass-rim);
    background-color: var(--glass-btn);
    -unity-text-align: middle-center;
}

/* The settings list has grown to a dozen rows: a little less padding keeps it on screen at the largest text size */
.pause__panel--settings {
    padding: 18px 28px 14px 28px;
}

.pause__panel--settings .menu-button--quiet {
    margin-top: 12px;
    padding-left: 4px;
}

.pause .menu-button:hover {
    background-color: var(--glass-bar);
}

/* Focus swells 4% over 120 ms; a press dips to 98% in 60 ms and comes back over 140 (feel-pass 2.12) */
.pause .menu-button {
    transform-origin: 50% 50%;
    transition-property: scale, background-color;
    transition-duration: 0.14s, 0.14s;
    transition-timing-function: ease-out;
}

/* Selection is an amber fill with dark text and a warm glow, as in the mockup */
.pause .menu-button:focus {
    background-color: var(--glass-sel);
    border-color: var(--glass-sel);
    color: var(--glass-sel-text);
    scale: 1.04 1.04;
    transition-duration: 0.12s, 0.12s;
}

.pause .menu-button:active {
    background-color: var(--glass-sel);
    color: var(--glass-sel-text);
    scale: 0.98 0.98;
    transition-duration: 0.06s, 0.06s;
}

/* The settings' tabs: skewed glass (Subnautica's tab buttons), the selected one edged in amber */
.settings-tabs {
    flex-direction: row;
    align-items: stretch;
    margin: 0 8px 14px 8px;
}

/* Each tab's skewed glass is painted on its wrapper, beneath the button, so the label is always drawn on top */
.settings-tab-wrap {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 40px;
    margin: 0 3px;
    --tab-color: var(--glass-deep);
    --tab-edge: var(--moon-track);
    --tab-edge-width: 1.5;
}

.settings-tab-wrap--on {
    --tab-color: var(--glass-bar);
    --tab-edge: var(--glass-sel);
    --tab-edge-width: 3;
}

.settings-tab-wrap--focus {
    --tab-color: var(--glass-sel);
    --tab-edge: var(--glass-sel);
    scale: 1.04 1.04;
}

.settings-tab {
    flex-grow: 1;
    min-width: 0;
    min-height: 40px;
    margin: 0;
    padding: 2px 16px;
    white-space: normal;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--glass-hi);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.pause .settings-tab:focus {
    color: var(--glass-sel-text);
}

.settings-page {
    min-height: 240px;
}

/* A choice stepped by a pair of arrows round its current value (resolution, window mode, FPS limit) */
.cycle__arrow {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 38px;
    margin: 0 2px;
    padding: 0;
}

.cycle__value {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 18px;
    white-space: normal;
    color: var(--glass-hi);
    -unity-text-align: middle-center;
}

.setting-row--idle {
    opacity: 0.5;
}

.section-label {
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--moon-warm-lamp);
    margin-top: 16px;
    margin-bottom: 4px;
    padding-left: 4px;
}

.section-label--first {
    margin-top: 0;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding-left: 4px;
}

/* A fixed label column wide enough for the longest label in English and Vietnamese; a longer one wraps */
.setting-row__label {
    width: 172px;
    flex-shrink: 0;
    margin-right: 6px;
    font-size: 18px;
    white-space: normal;
    color: var(--moon-text-dim);
}

.setting-row__slider {
    flex-grow: 1;
    margin: 0 8px;
}

.setting-row__value {
    width: 52px;
    font-size: 18px;
    color: var(--moon-text-faint);
    -unity-text-align: middle-right;
}

.pause .unity-base-slider__tracker {
    height: 5px;
    margin-top: -2px;
    border-width: 0;
    border-radius: 3px;
    background-color: var(--moon-track);
}

.pause .unity-base-slider__fill {
    border-radius: 3px;
    background-color: var(--glass-ring);
}

.pause .unity-base-slider__dragger {
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-width: 2px;
    border-radius: 11px;
    border-color: var(--glass-rim-glow);
    background-color: var(--glass-hi);
}

.pause .unity-base-slider__dragger-border {
    display: none;
}

.pause .unity-base-slider:focus .unity-base-slider__dragger {
    border-color: var(--glass-sel);
    background-color: var(--glass-sel);
}

.pause .unity-base-slider:focus .unity-base-slider__fill {
    background-color: var(--glass-sel);
}

.pause .unity-toggle__checkmark {
    width: 26px;
    height: 26px;
    border-width: 1px;
    border-radius: 7px;
    border-color: var(--glass-rim);
    background-color: var(--moon-glass);
    -unity-background-image-tint-color: var(--glass-sel-text);
}

.pause .unity-toggle:focus .unity-toggle__checkmark {
    border-color: var(--glass-sel);
    border-width: 2px;
}

.pause .unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--glass-ring);
}

/* The crew's lab (M3-19): the HUD steps aside; the lab's place line and its few first-time prompts, low and centred */

.lab-prompts {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: center;
}

.lab-arrows {
    flex-direction: row;
    align-items: center;
    margin: 0 6px 0 2px;
}

.lab-arrow {
    width: 14px;
    height: 14px;
    margin: 0 2px;
    --arrow-color: var(--glass-hi);
}

.lab-prompts__chip {
    margin: 0 10px;
}

/*
 * The tech board's labels while 07 looks at it (M3-21): the recovery panel's protocol and its four targets, each
 * with its row of lamps (dark glass, warm amber when lit), then the pins Kenji's board knows. Left of the board,
 * no plate: cream type on its own soft shadow, a decoded sheet quieter than a built one.
 */

.recovery-board {
    position: absolute;
    left: 0;
    top: 24%;
    width: 30%;
}

.recovery-board__title {
    margin-bottom: 12px;
    font-size: 18px;
    letter-spacing: 4px;
    color: var(--moon-text);
    text-shadow: 0 2px 12px var(--moon-shadow);
}

.recovery-board__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 4px 0;
}

.recovery-board__target {
    font-size: 22px;
    color: var(--moon-cream);
    text-shadow: 0 2px 12px var(--moon-shadow);
}

.recovery-board__lamps {
    flex-direction: row;
    margin-left: 16px;
}

.recovery-board__lamp {
    width: 10px;
    height: 10px;
    margin-left: 6px;
    border-radius: 5px;
    background-color: var(--moon-track);
}

.recovery-board__lamp--lit {
    background-color: var(--moon-warm-lamp);
}

.recovery-board__known {
    margin-top: 18px;
    margin-bottom: 4px;
    font-size: 18px;
    letter-spacing: 4px;
    color: var(--moon-text);
    text-shadow: 0 2px 12px var(--moon-shadow);
}

.recovery-board__nodes {
    flex-direction: row;
    flex-wrap: wrap;
}

.recovery-board__node {
    margin-right: 14px;
    font-size: 22px;
    color: var(--moon-cream);
    text-shadow: 0 2px 12px var(--moon-shadow);
}

.recovery-board__node--decoded {
    color: var(--moon-text);
    opacity: 0.75;
}

/*
 * The recipe card (M3-24 B): looking at the tower's hopper or a board sheet, a quiet card right of centre, no
 * plate: the next level's name and title, needs and have in material icons, the component still missing, and where
 * it is built, all on the floating names' soft shadow.
 */

.recipe-card {
    position: absolute;
    right: 7%;
    top: 34%;
    width: 26%;
    min-width: 360px;
    padding: 18px 22px 16px 22px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPanel.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.5;
}

/* Moonlight Glass: the card is glass, so the floating names' shadow under it stays empty */
.recipe-card .soft-shadow {
    display: none;
}

.recipe-card__title {
    font-size: 24px;
    letter-spacing: 3px;
    color: var(--glass-hi);
    text-shadow: 0 2px 12px var(--moon-shadow);
}

.recipe-card__level {
    margin-bottom: 8px;
    font-size: 17px;
    color: var(--moon-text);
    text-shadow: 0 2px 12px var(--moon-shadow);
}

.recipe-card__row {
    margin: 3px 0;
}

.recipe-card__word {
    margin-bottom: 4px;
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--moon-text);
    text-shadow: 0 2px 12px var(--moon-shadow);
}

.recipe-card__line {
    margin-top: 4px;
    font-size: 16px;
    color: var(--moon-text);
    white-space: normal;
    text-shadow: 0 2px 12px var(--moon-shadow);
}

.recipe-card__where {
    margin-top: 8px;
    font-size: 16px;
    color: var(--glass-sel);
    white-space: normal;
    text-shadow: 0 2px 12px var(--moon-shadow);
}

/*
 * The protocol readout (M3-24 B): the same panel in 07's lens at the end of the opening, high on the left over the
 * dark sky. Power, the first target, reads brightest with its first need under it; the others wait, quieter.
 */

.protocol-readout {
    top: 16%;
    padding: 18px 24px 16px 24px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPanel.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.5;
}

.protocol-readout__title {
    color: var(--glass-hi);
}

.protocol-readout__row {
    opacity: 0.6;
}

.protocol-readout__row--first {
    opacity: 1;
}

.protocol-readout__need {
    margin: 0 0 6px 18px;
    font-size: 18px;
    color: var(--glass-sel);
    text-shadow: 0 2px 12px var(--moon-shadow);
}

/*
 * The cargo screen (M3-25 §2.4, Tab / View): 07's hold on the left, home's shelves on the right, and a "07 can" page;
 * Moonlight Glass over the blur. Cell sizes are written by CargoScreen to fit the screen.
 */

.cargo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.cargo__panel {
    max-width: 96%;
    padding: 22px 34px 20px 34px;
    background-image: url("project://database/Assets/_Project/Generated/UI/Glass/GlassPanel.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.5;
}

.cargo__tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 14px;
}

.cargo__tabs .settings-tab-wrap {
    flex-grow: 0;
    flex-basis: auto;
    width: 220px;
}

.cargo .settings-tab:focus {
    color: var(--glass-sel-text);
}

.cargo__page {
    min-width: 320px;
}

.cargo__page--columns {
    flex-direction: row;
    align-items: flex-start;
}

.cargo__column--home {
    margin-left: 42px;
}

.cargo__heading {
    margin-bottom: 10px;
    font-size: 24px;
    letter-spacing: 2px;
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-SemiBold.asset");
}

.cargo__note {
    margin-bottom: 8px;
    font-size: 19px;
    color: var(--glass-sel);
}

.cargo__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.cargo__shelves {
    flex-direction: row;
    flex-wrap: wrap;
}

.cargo__shelf {
    margin: 0 22px 12px 0;
}

.cargo__shelf-name {
    margin-bottom: 6px;
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--moon-text-dim);
}

.cargo__cell {
    margin: 0 6px 6px 0;
    justify-content: center;
    align-items: center;
    border-width: 1.5px;
    border-radius: 10px;
    border-color: var(--glass-rim);
    background-color: var(--glass-btn);
}

.cargo__cell--empty {
    border-color: var(--moon-track);
    background-color: rgba(0, 0, 0, 0);
}

.cargo__cell--empty .material-icon,
.cargo__cell--empty .cargo__units {
    display: none;
}

.cargo__cell .material-icon {
    width: 55%;
    height: 55%;
}

.cargo__units {
    position: absolute;
    right: 5px;
    bottom: 2px;
    font-size: 13px;
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-SemiBold.asset");
}

/* A shelf not built yet: a pencil outline that says so */
.cargo__pencil {
    padding: 14px 18px;
    border-width: 1.5px;
    border-radius: 12px;
    border-color: var(--moon-track);
}

.cargo__pencil-text {
    font-size: 18px;
    white-space: normal;
    color: var(--moon-text-dim);
}

.cargo__pencil-cost {
    margin-top: 8px;
    color: var(--glass-sel);
}

.cargo__can {
    min-width: 560px;
}

.can-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 4px;
}

.can-row__glyph {
    width: 74px;
    align-items: center;
}

.can-row__verb {
    width: 190px;
    font-size: 22px;
    color: var(--glass-hi);
    -unity-font-definition: url("project://database/Assets/_Project/Generated/UI/Fonts/Exo2-SemiBold.asset");
}

.can-row__line {
    flex-shrink: 1;
    font-size: 19px;
    white-space: normal;
    color: var(--glass-hi);
}

.can-row--pencil .can-row__verb,
.can-row--pencil .can-row__line {
    color: var(--moon-text-dim);
}

.cargo__summary {
    margin-top: 12px;
    font-size: 19px;
    color: var(--moon-text-dim);
    -unity-text-align: middle-center;
}
